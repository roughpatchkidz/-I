        if ((mp.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) && mp.memoryHeaps[i].size > dl_max) dl_max = mp.memoryHeaps[i].size;
    int hv = -1;
