  qwen38-tiny-check:
    name: Qwen3.8 tiny oracle (GDN + QSA + PLE + MoE)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: c/tools/requirements-qwen38-tiny.txt
