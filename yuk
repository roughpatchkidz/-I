/* ================================================= markdown (safe: everything escaped first) */
function inline(s){return s.replace(/`([^`]+)`/g,(m,c)=>`<code class="inl">${c}</code>`).replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/(^|[^*])\*([^*\s][^*]*)\*/g,'$1<em>$2</em>')
  .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>')}
function mdBlock(text){const lines=esc(text).split('\n');let out='',list=null,para=[],table=[];
  const flushP=()=>{if(para.length){out+=`<p>${inline(para.join('<br>'))}</p>`;para=[]}};
  const flushL=()=>{if(list){out+=`</${list}>`;list=null}};
  const flushT=()=>{if(table.length){const rows=table.filter(r=>!/^\s*\|?\s*:?-{2,}/.test(r)).map(r=>r.replace(/^\s*\||\|\s*$/g,'').split('|').map(c=>inline(c.trim())));
    out+=`<div class="tablewrap"><table class="table mdtable"><thead><tr>${rows[0].map(c=>`<th>${c}</th>`).join('')}</tr></thead><tbody>${rows.slice(1).map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;table=[]}};
  for(const ln of lines){let m;
    if(/^\s*\|.*\|\s*$/.test(ln)){flushP();flushL();table.push(ln);continue}else flushT();
    if((m=ln.match(/^(#{1,4})\s+(.*)/))){flushP();flushL();out+=`<h${m[1].length+2} class="mdh">${inline(m[2])}</h${m[1].length+2}>`;continue}
    if((m=ln.match(/^\s*[-*]\s+(.*)/))){flushP();if(list!=='ul'){flushL();out+='<ul>';list='ul'}out+=`<li>${inline(m[1])}</li>`;continue}
    if((m=ln.match(/^\s*\d+[.)]\s+(.*)/))){flushP();if(list!=='ol'){flushL();out+='<ol>';list='ol'}out+=`<li>${inline(m[1])}</li>`;continue}
    if(!ln.trim()){flushP();flushL();continue}
    flushL();para.push(ln)}
  flushP();flushL();flushT();return citeify(out)}
function md(text,artifacts){let out='',i=0;const re=/```([\w+-]*)[^\n]*\n([\s\S]*?)(```|$)/g;let m;
  while((m=re.exec(text))){out+=mdBlock(text.slice(i,m.index));const lang=(m[1]||'').toLowerCase(),code=m[2];
    const isHtml=lang==='html'||/^\s*<!doctype html|^\s*<html/i.test(code);
    if(isHtml&&m[3]&&artifacts)artifacts.push(code);
    out+=`<div class="codeblock"><div class="codehead"><span>${esc(lang||'codice')}</span><button class="sbtn sbtn--xs" data-copycode>Copia</button></div><pre><code>${esc(code)}</code></pre></div>`;i=re.lastIndex;if(!m[3])break}
  if(i<text.length)out+=mdBlock(text.slice(i));return out}
function mdSegs(text){const out=[];let i=0,m;const re=/```([\w+-]*)[^\n]*\n([\s\S]*?)(```|$)/g;
  while((m=re.exec(text))){if(m.index>i)out.push({t:'md',v:text.slice(i,m.index)});out.push({t:'code',lang:(m[1]||'').toLowerCase(),v:m[2]});i=re.lastIndex;if(!m[3])break}
  if(i<text.length)out.push({t:'md',v:text.slice(i)});return out}
/* While the answer streams only what changed is touched: the text before a code block is
   final, and the code block being written grows inside one text node, so its <pre> keeps
   the reader's scroll (and follows the new lines only while it is at the bottom). */
function liveMd(el){const segs=[],caret=document.createElement('span');caret.className='caret';
  return text=>{const parts=mdSegs(text);
    for(let k=0;k<parts.length;k++){const p=parts[k];let g=segs[k];
      if(g&&g.t!==p.t){segs.splice(k).forEach(x=>x.el.remove());g=null}
      if(!g){g={t:p.t,v:'',el:document.createElement('div')};
        if(p.t==='code'){g.el.className='codeblock';g.el.innerHTML=`<div class="codehead"><span></span><button class="sbtn sbtn--xs" data-copycode>Copia</button></div><pre><code></code></pre>`;
          g.lang=g.el.querySelector('.codehead span');g.pre=g.el.querySelector('pre');g.tn=document.createTextNode('');g.el.querySelector('code').appendChild(g.tn)}
        else g.el.className='mdseg';
        el.insertBefore(g.el,caret.parentNode===el?caret:null);segs.push(g)}
      if(p.t==='code'){const l=p.lang||'codice';if(g.lang.textContent!==l)g.lang.textContent=l}
      if(p.v===g.v)continue;
      if(p.t==='code'){const pre=g.pre,follow=pre.scrollHeight-pre.scrollTop-pre.clientHeight<24;
        if(p.v.startsWith(g.v))g.tn.appendData(p.v.slice(g.v.length));else g.tn.data=p.v;
        if(follow)pre.scrollTop=pre.scrollHeight}
      else g.el.innerHTML=mdBlock(p.v);
      g.v=p.v}
    segs.splice(parts.length).forEach(x=>x.el.remove());
    if(text){if(caret.parentNode!==el)el.appendChild(caret)}else caret.remove()}}

/* ================================================= web search (SearXNG on the engine's machine, via /web/*) */
let WEBOK=false,CITE=null;const WEB_ROUNDS=3;
const WEB_TOOLS=[{type:'function',function:{name:'cerca',description:'Cerca sul web. Usalo per fatti recenti, notizie, prezzi, versioni, date, o quando non sei sicuro di una cosa. Restituisce risultati numerati con titolo, link ed estratto.',parameters:{type:'object',properties:{query:{type:'string',description:'la ricerca: poche parole, nella lingua più adatta'}},required:['query']}}},
  {type:'function',function:{name:'apri',description:"Legge il testo di una pagina web (tagliato a qualche migliaio di caratteri). Usalo su un link dei risultati quando l'estratto non basta.",parameters:{type:'object',properties:{url:{type:'string',description:'il link da leggere'}},required:['url']}}}];
const webSystem=()=>`Oggi è ${new Date().toLocaleDateString(LOC,{weekday:'long',day:'numeric',month:'long',year:'numeric'})}. Hai due strumenti: cerca (una ricerca sul web) e apri (legge una pagina). Usali quando la domanda riguarda fatti recenti o cose che non sai con certezza; per il resto rispondi direttamente. Quando usi quello che hai trovato, cita la fonte con il suo numero tra parentesi quadre, per esempio [1] o [2]. Rispondi nella lingua dell'utente.`;
const host=u=>{try{return new URL(u).hostname.replace(/^www\./,'')}catch(e){return ''}};
async function runWebTool(c,a,signal){let args={};try{args=JSON.parse(c.args||'{}')}catch(e){}
  const step={kind:c.name==='apri'?'open':'search',q:String(args.query||args.q||''),url:String(args.url||''),state:'run',results:[]};a.steps.push(step);
  const cite=(u,title)=>{let n=a.sources.findIndex(x=>x.url===u)+1;if(!n){a.sources.push({url:u,title:title||u});n=a.sources.length}return n};
  try{if(step.kind==='search'){if(!step.q)throw new Error('ricerca vuota');
      const r=await fetch(url('/web/search?n=6&q='+encodeURIComponent(step.q)),{headers:H(),signal});const d=await r.json();if(!r.ok)throw new Error(d.error||r.status);
      const lines=d.results.map(x=>{const n=cite(x.url,x.title);step.results.push(n);return `[${n}] ${x.title}\n${x.url}${x.date?` (${x.date})`:''}\n${x.snippet}`});
      step.state='ok';return (d.answers&&d.answers.length?`Risposta diretta: ${d.answers.join(' ')}\n\n`:'')+(lines.length?`Risultati per "${step.q}":\n\n${lines.join('\n\n')}`:`Nessun risultato per "${step.q}".`)}
    if(!/^https?:\/\//.test(step.url))throw new Error('link non valido');
    const r=await fetch(url('/web/page?max=4000&url='+encodeURIComponent(step.url)),{headers:H(),signal});const d=await r.json();if(!r.ok)throw new Error(d.error||r.status);
    const n=cite(d.url,d.title);step.results=[n];step.title=d.title;step.state='ok';
    return `[${n}] ${d.title||''}\n${d.url}\n\n${d.text}${d.truncated?'\n[testo tagliato]':''}`}
  catch(e){if(signal.aborted)throw e;step.state='err';step.err=String(e.message||e);return `Errore: ${step.err}`}}
function stepsHTML(a){if(!a.steps||!a.steps.length)return '';
  return `<div class="wsteps">${a.steps.map(s=>`<div class="wstep is-${s.state}"><svg class="ic ic--sm"><use href="#${s.kind==='open'?'i-link':'i-search'}"/></svg><span>${s.kind==='open'?'Legge':'Cerca'} <b>${esc(s.kind==='open'?(s.title||host(s.url)||s.url):s.q)}</b></span><small>${s.state==='run'?'<span class="dots"><i></i><i></i><i></i></span>':s.state==='err'?esc(s.err):s.kind==='search'?`${s.results.length} risultati`:`[${s.results[0]}]`}</small></div>`).join('')}</div>`}
function sourcesHTML(a){if(!a.sources||!a.sources.length)return '';
  return `<details class="wsrc"><summary><svg class="ic ic--sm"><use href="#i-link"/></svg>Fonti · ${a.sources.length}<svg class="ic ic--sm chev"><use href="#i-chev"/></svg></summary><ol>${a.sources.map(x=>`<li><a href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.title||x.url)}</a><small>${esc(host(x.url))}</small></li>`).join('')}</ol></details>`}
/* [1] or [1, 3] in the answer: a link to that source, when the turn has sources */
function citeify(html){if(!CITE||!CITE.length)return html;
  return html.replace(/\[(\d{1,2}(?:\s*,\s*\d{1,2})*)\]/g,(m,list)=>{const ns=list.split(/\s*,\s*/).map(Number);if(!ns.every(n=>n>=1&&n<=CITE.length))return m;
    return ns.map(n=>`<a class="cite" href="${esc(CITE[n-1].url)}" target="_blank" rel="noopener" title="${esc(CITE[n-1].title||CITE[n-1].url)}">${n}</a>`).join('')})}

