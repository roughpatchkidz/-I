  if(AGENTS&&s&&!s.dataset.busy){s.dataset.ok=String(n>0);s.lastChild.textContent=n?n+(n===1?' agente pronto':' agenti pronti'):'Nessun agente installato'}}
$('#agentsGrid').addEventListener('click',async e=>{const b=e.target.closest('.agent');if(!b||b.classList.contains('is-off'))return;
  const s=$('#agentStatus');
  if(!model){s.dataset.ok='false';s.lastChild.textContent='Prima scegli un modello';return}
  b.classList.add('is-busy');s.dataset.busy='1';s.lastChild.textContent='Apro '+b.querySelector('b').textContent+'...';
  try{const r=await fetch('/agents/launch',{method:'POST',headers:AH,body:JSON.stringify({agent:b.dataset.id,model,folder:ST.agentDir||'',key:ST.key||''})});
    const j=await r.json().catch(()=>({}));s.dataset.ok=String(!!j.ok);s.lastChild.textContent=j.message||(j.ok?'Aperto':'Non riuscito')}
  catch(err){s.dataset.ok='false';s.lastChild.textContent='Non riuscito: '+err.message}
  finally{setTimeout(()=>{b.classList.remove('is-busy');delete s.dataset.busy},1500)}});
