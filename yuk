/* idle: rare and small, never across the bar by himself */
let lastInput=performance.now();
setInterval(()=>{if(!shown||calm)return;const now=performance.now();
  if(M.mode==='idle'&&now-lastInput>90000){act('sleep');return}
  if(M.mode==='idle'&&now>M.nextIdle&&!M.dragging)act(pick(['swing','swing','look','flap']))
},1000);
