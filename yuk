.picker__btn span{flex:1;text-align:left}
.picker__btn.nudge{animation:nudge .9s var(--ease) 2}
@keyframes nudge{30%{box-shadow:0 0 0 6px var(--accent-tint);border-color:var(--accent)}}
.menu{position:absolute;z-index:30;top:calc(100% + 8px);left:50%;transform:translateX(-50%);width:520px;max-height:calc(100vh - 230px);overflow-y:auto;max-width:calc(100vw - 32px);padding:8px;border:1px solid var(--line);border-radius:16px;background:var(--surface);box-shadow:var(--sh-pop);display:none}
.menu.open{display:block;animation:pop .16s var(--ease)}
@keyframes pop{from{opacity:0;transform:translate(-50%,-4px)}}
.menu__item{display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border:0;border-radius:11px;background:transparent;text-align:left;cursor:pointer}
.menu__item:hover{background:var(--surface-2)}
.menu__icon{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;border:1px solid var(--line);background:var(--surface-2);font-weight:900;font-size:12px;color:var(--ink-soft);flex:none}
.menu__text{flex:1;min-width:0}
.menu__text b{display:block;font-size:14px;font-weight:700;color:var(--ink)}
.menu__text small{display:block;font-size:12px;color:var(--ink-muted)}
.menu__size{font-size:12px;color:var(--ink-muted);font-variant-numeric:tabular-nums;margin-left:6px}
.menu__foot{display:flex;justify-content:space-between;align-items:center;padding:10px 12px 4px;margin-top:4px;border-top:1px solid var(--line);font-size:12.5px;color:var(--ink-muted)}
.menu__foot a{color:var(--accent-text);text-decoration:none;font-weight:600}
.menu--top.open{animation:none}.menu--top{top:auto;bottom:calc(100% + 8px);left:auto;right:0;transform:none}

.thread{max-width:820px;margin:0 auto;padding:18px 28px 40px;display:flex;flex-direction:column;gap:22px}
.app:not([data-chat="on"]) .thread{display:none}
.msg-user{align-self:flex-end;max-width:85%;padding:11px 16px;border-radius:18px 18px 6px 18px;background:var(--surface-2);border:1px solid var(--line-soft);color:var(--ink);white-space:pre-wrap}
.msg-asst{display:flex;flex-direction:column;gap:12px;color:var(--ink-soft)}
.msg-asst p{margin:0}
.msg-asst ul{margin:0;padding-left:22px;display:flex;flex-direction:column;gap:6px}
.msg-asst strong{color:var(--ink)}
code.inl{font-family:var(--mono);font-size:.86em;padding:2px 6px;border-radius:6px;background:var(--surface-2);border:1px solid var(--line);color:var(--ink)}
.status-line{display:flex;align-items:center;gap:10px;font-size:13.5px;color:var(--ink-muted)}
.dots i{display:inline-block;width:5px;height:5px;margin-right:3px;border-radius:50%;background:currentColor;animation:dot 1s infinite}
.dots i:nth-child(2){animation-delay:.15s}.dots i:nth-child(3){animation-delay:.3s}
@keyframes dot{50%{opacity:.2}}
.toolsum>summary{list-style:none;display:inline-flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;color:var(--ink-muted)}
.toolsum>summary::-webkit-details-marker{display:none}
.toolsum>summary:hover{color:var(--ink)}
.toolsum .chev{transition:transform var(--dur)}
.toolsum[open] .chev{transform:rotate(180deg)}
.diffnum{font-weight:700;font-variant-numeric:tabular-nums}.add{color:var(--add)}.del{color:var(--del)}
.steps{margin-top:10px;border-left:2px solid var(--line);padding-left:16px;display:flex;flex-direction:column;gap:9px}
.step{display:flex;gap:10px;font-size:13px;color:var(--ink-soft)}
.step code{font-family:var(--mono);font-size:12px;color:var(--ink)}
.step small{display:block;font-family:var(--mono);font-size:12px;color:var(--ink-muted)}
.artifact-card{display:flex;align-items:center;gap:14px;padding:13px 13px 13px 16px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
.artifact-card:hover{border-color:color-mix(in srgb,var(--accent) 50%,var(--line))}
.filetag{display:grid;place-items:center;min-width:50px;height:32px;padding:0 8px;border-radius:9px;border:1px solid var(--line);background:var(--surface-2);font-size:11px;font-weight:900;letter-spacing:.04em}
.artifact-card__text{flex:1;min-width:0}
.artifact-card__text b{display:block}
.artifact-card__text small{color:var(--ink-muted);font-size:13px}
.openbtn{height:36px;padding:0 16px;border-radius:11px;border:1.5px solid var(--line);background:var(--surface);font-weight:700;font-size:14px;cursor:pointer}
.openbtn:hover{background:var(--surface-2)}
.msg-stats{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--ink-muted);font-variant-numeric:tabular-nums}
.msg-stats b{color:var(--ink-soft);font-weight:600}
.caret{display:inline-block;width:8px;height:16px;margin-left:2px;vertical-align:-2px;background:var(--accent);animation:dot .8s infinite}

.dock{flex:none;padding:0 24px 18px;position:relative}
.composer-wrap{position:relative;max-width:930px;margin:0 auto}
.composer{position:relative;z-index:4;display:flex;align-items:flex-end;gap:10px;min-height:58px;padding:10px 10px 10px 14px;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--sh-bar);transition:border-color var(--dur)}
.composer:focus-within{border-color:color-mix(in srgb,var(--ink) 28%,var(--line))}
.composer textarea{flex:1;border:0;outline:0;resize:none;background:transparent;color:var(--ink);font:400 16px/1.5 var(--font);padding:6px 4px;max-height:200px;min-height:24px}
.composer textarea::placeholder{color:var(--ink-muted)}
.composer .btn-icon{color:var(--ink-soft)}
.send{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:50%;background:var(--surface-3);color:var(--ink-muted);cursor:pointer;transition:background var(--dur),color var(--dur)}
.send.ready{background:var(--ink);color:var(--bg)}
.send.stop{background:var(--ink);color:var(--bg)}
.hint{display:flex;justify-content:flex-end;gap:10px;max-width:930px;margin:8px auto 0;font-size:13px;color:var(--ink-muted)}

/* mascot */
.mascot{position:absolute;bottom:calc(100% - 1px);left:0;width:60px;height:60px;z-index:6;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none}
.mascot.behind{z-index:3}
.mascot canvas{display:block;width:60px;height:60px;image-rendering:pixelated}
.mascot[hidden]{display:none}
.mascot.dragging{cursor:grabbing}
.bubble{position:absolute;right:0;bottom:calc(100% + 2px);transform:scale(.6);transform-origin:bottom right;opacity:0;pointer-events:none;white-space:nowrap;max-width:300px;padding:6px 11px;border:1.5px solid var(--line);border-radius:10px;box-shadow:var(--sh-pop);background:var(--surface);color:var(--ink);font-size:13px;font-weight:600;line-height:1.35;transition:opacity .15s,transform .2s var(--ease);z-index:7}
.bubble::after{content:"";position:absolute;right:24px;top:100%;width:9px;height:9px;background:var(--surface);border-right:1.5px solid var(--line);border-bottom:1.5px solid var(--line);transform:translateY(-5px) rotate(45deg)}
.bubble.show{opacity:1;transform:scale(1)}
.bubble.wrap{white-space:normal;width:240px}
.zz{position:absolute;font-family:"Bytesized",var(--mono);font-size:16px;color:var(--accent-text);pointer-events:none;animation:zz 2.4s linear forwards}
@keyframes zz{from{opacity:0;transform:translate(0,0)}15%{opacity:.8}to{opacity:0;transform:translate(14px,-34px)}}
.spark{position:absolute;width:6px;height:6px;pointer-events:none;animation:sp .7s ease-out forwards}
@keyframes sp{to{opacity:0;transform:translate(var(--dx),var(--dy))}}

/* preview panel */
.artifact-panel{min-width:0;min-height:0;display:flex;flex-direction:column;background:var(--surface);border-left:1px solid var(--line);overflow:hidden}
.app:not([data-preview="open"]) .artifact-panel{border-left:0}
.artifact-panel__head{display:flex;align-items:center;gap:6px;height:60px;flex:none;padding:0 12px;border-bottom:1px solid var(--line);min-width:420px}
.ptab{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 13px;border:0;border-radius:11px;background:transparent;color:var(--ink-muted);font-size:13px;font-weight:500;cursor:pointer}
.ptab[aria-selected="true"]{background:var(--surface-2);color:var(--ink);font-weight:600}
.artifact-content{flex:1;min-height:0;display:flex;flex-direction:column;min-width:420px}
.artifact-content iframe{flex:1;width:100%;border:0;background:#0f1a24}
.artifact-code{flex:1;min-height:0;overflow:auto;margin:0;padding:16px 18px;background:var(--code-bg);color:#e3e7ea;font:400 12.5px/1.65 var(--mono);white-space:pre}
.artifact-code .ln{display:inline-block;width:34px;color:#5d6770;user-select:none}

/* gallery */
.modal{position:fixed;inset:0;z-index:50;display:none;place-items:center;background:rgba(0,0,0,.55);padding:24px}
.modal.open{display:grid}
.sheet{width:min(1040px,100%);max-height:calc(100vh - 48px);overflow:auto;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--sh-pop)}
.sheet__head{display:flex;align-items:center;gap:12px;padding:18px 22px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--surface);z-index:2}
.sheet__head h2{margin:0;font-size:18px;font-weight:800;flex:1}
.sheet__body{padding:20px 22px 24px;display:flex;flex-direction:column;gap:18px}
.sheet__body h3{margin:0;font-size:13px;font-weight:700;color:var(--ink-muted);letter-spacing:.04em;text-transform:uppercase}
.poses{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:12px}
.pose{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 6px 10px;border:1px solid var(--line-soft);border-radius:14px;background:var(--surface-2);font-size:12px;color:var(--ink-muted)}
.pose canvas{width:80px;height:80px;image-rendering:pixelated}
.pose.new{border-color:color-mix(in srgb,var(--accent) 45%,var(--line))}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.act{height:34px;padding:0 14px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink-soft);font-size:13px;font-weight:600;cursor:pointer}
.act:hover{border-color:var(--accent);color:var(--ink)}
.legend{font-size:13px;color:var(--ink-muted);margin:0;line-height:1.6}

.toggle{position:relative;width:36px;height:21px;border-radius:999px;border:0;background:var(--line);cursor:pointer;transition:background var(--dur);flex:none}
.toggle::after{content:"";position:absolute;top:3px;left:3px;width:15px;height:15px;border-radius:50%;background:#fff;transition:transform var(--dur) var(--ease)}
.toggle[aria-checked="true"]{background:var(--accent)}
.toggle[aria-checked="true"]::after{transform:translateX(15px)}
.ribbon{position:fixed;left:50%;transform:translateX(-50%);top:14px;z-index:40;display:flex;align-items:center;gap:10px;padding:7px 8px 7px 13px;border-radius:999px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--sh-pop);font-size:12px;color:var(--ink-muted)}
.ribbon button{border:0;background:var(--surface-2);border-radius:999px;padding:4px 10px;cursor:pointer;font-size:12px;color:var(--ink-soft)}
@media (max-width:900px){.app[data-preview="open"]{grid-template-columns:var(--rail) 0 minmax(0,1fr) 0}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important}}
/* ---------------- views */
.view{display:none;flex:1;min-height:0;flex-direction:column}
.view.is-active{display:flex}
.app:not([data-view="chat"]) .top .chip,.app:not([data-view="chat"]) .top .pill,.app:not([data-view="chat"]) .top .chat-only{display:none!important}
.top .chat-only{display:none}
.app[data-chat="on"][data-view="chat"] .top .chat-only{display:inline-flex}
.top__meta{font-size:12.5px;color:var(--ink-muted);font-variant-numeric:tabular-nums;white-space:nowrap;align-items:center;gap:10px}
.top__meta b{color:var(--ink-soft);font-weight:600}
.popwrap{position:relative;display:inline-flex}
.pop{position:absolute;z-index:30;top:calc(100% + 8px);right:0;min-width:220px;padding:6px;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--sh-pop);display:none}
.pop.open{display:block}
.pop--up{top:auto;bottom:calc(100% + 10px);left:0;right:auto}
.pop button{display:flex;align-items:center;gap:10px;width:100%;padding:9px 12px;border:0;border-radius:10px;background:transparent;font-size:14px;color:var(--ink-soft);cursor:pointer;text-align:left}
.pop button:hover{background:var(--surface-2);color:var(--ink)}
.pop small{margin-left:auto;color:var(--ink-muted);font-size:12px}
.pop hr{border:0;border-top:1px solid var(--line);margin:6px 4px}
.navsearch{display:flex;align-items:center;gap:8px;height:38px;padding:0 10px;margin:0 0 6px;border:1px solid var(--line);border-radius:11px;background:var(--surface-2);color:var(--ink-muted)}
.navsearch input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);font:inherit;font-size:13.5px}
.navitem[aria-current="page"]{background:var(--surface-2);color:var(--ink);font-weight:700}
.navitem[aria-current="page"] .ic{color:var(--accent)}
.navgroup{display:flex;flex-direction:column;gap:2px;margin-bottom:8px}

/* ---------------- composer extras */
.composer-chips{display:flex;gap:8px;flex-wrap:wrap;max-width:930px;margin:0 auto 8px}
.composer-chips:empty{display:none}
.cchip{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 6px 0 10px;border:1px solid var(--line);border-radius:10px;background:var(--surface);font-size:13px;color:var(--ink-soft)}
.cchip .thumb{width:22px;height:22px;border-radius:5px;background:linear-gradient(135deg,#d43fce,#00a8be)}
.cchip button{display:grid;place-items:center;width:22px;height:22px;border:0;border-radius:6px;background:transparent;color:var(--ink-muted);cursor:pointer}
.imgopts{display:none;align-items:center;gap:8px;flex-wrap:wrap;max-width:930px;margin:8px auto 0;font-size:12.5px;color:var(--ink-muted)}
.app[data-mode="image"] .imgopts{display:flex}
.imgopts select,.imgopts input{height:30px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);font:inherit;font-size:12.5px;padding:0 8px}
.imgopts input{width:110px}
.modetag{display:none;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:999px;background:var(--plum-tint);color:var(--plum-text);font-size:12px;font-weight:700;white-space:nowrap;align-self:center}
.app[data-mode="image"] .modetag{display:inline-flex}
.modetag button{border:0;background:transparent;color:inherit;cursor:pointer;padding:0;display:grid;place-items:center}

/* ---------------- chat extras */
.msg-actions{display:flex;align-items:center;gap:2px;margin-left:-8px}
.msg-actions .btn-icon{width:32px;height:32px}
.notice{display:flex;gap:10px;align-items:flex-start;padding:10px 14px;border:1px dashed var(--line);border-radius:12px;font-size:13px;color:var(--ink-muted)}
.notice b{color:var(--ink-soft)}
.trunc{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;background:var(--warn-tint);color:var(--warn-text);font-size:12px;font-weight:700;cursor:help;align-self:flex-start}
.imgturn{display:flex;flex-direction:column;gap:10px;max-width:560px}
.imgturn canvas{width:100%;aspect-ratio:1;border-radius:14px;border:1px solid var(--line);image-rendering:auto;background:var(--surface-2)}
.imgturn .bar{height:6px;border-radius:999px;background:var(--surface-2);overflow:hidden}
.imgturn .bar i{display:block;height:100%;width:0;background:var(--plum);transition:width .25s}
.imgturn .meta{display:flex;gap:12px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-muted)}
.imgbtns{display:flex;gap:8px;flex-wrap:wrap}
.sbtn{height:34px;padding:0 13px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink-soft);font-size:13px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
.sbtn:hover{background:var(--surface-2);color:var(--ink)}
.sbtn--primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.sbtn--primary:hover{background:var(--accent-hover)}

/* ---------------- pages */
.page__body{flex:1;min-height:0;overflow-y:auto}
.wrap{max-width:1180px;margin:0 auto;padding:14px 28px 60px;display:flex;flex-direction:column;gap:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px}
.h2{margin:0;font-size:16.5px;font-weight:700}
.sub{margin:4px 0 0;font-size:13px;color:var(--ink-muted)}
.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.spacer{flex:1}
.tabs{display:inline-flex;gap:4px;padding:4px;background:var(--surface-2);border:1px solid var(--line);border-radius:13px}
.tab{display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 13px;border:0;border-radius:9px;background:transparent;color:var(--ink-muted);font-weight:500;font-size:13px;cursor:pointer}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{background:var(--surface);color:var(--ink);font-weight:700;box-shadow:0 1px 2px rgba(0,0,0,.2)}
.progress{height:8px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line-soft);overflow:hidden}
.progress>i{display:block;height:100%;border-radius:inherit;background:var(--accent);transition:width .6s var(--ease)}
.progress[data-tone="info"]>i{background:var(--info)}.progress[data-tone="plum"]>i{background:var(--plum)}.progress[data-tone="sun"]>i{background:#f5a524}
.demo-note{font-size:12px;color:var(--ink-muted);margin:0}
/* monitor */
.state__head{display:flex;align-items:center;flex-wrap:wrap;gap:12px 18px}
.state__badges{display:flex;flex-wrap:wrap;gap:7px}
.state__badges .badge{opacity:.38}.state__badges .badge[data-active="true"]{opacity:1}
.state__row{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px 18px;margin:16px 0 10px;font-size:13px}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.metric{min-width:0;min-height:168px;padding:16px 18px;display:flex;flex-direction:column;gap:10px}
.metric__label{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--ink-muted)}
.metric__label .ic{width:16px;height:16px}
.metric__value{font-weight:900;font-size:clamp(22px,2.3vw,32px);line-height:1;font-variant-numeric:tabular-nums}
.metric__unit{font-weight:500;font-size:12.5px;color:var(--ink-muted);margin-left:4px}
.metric__sub{font-size:12px;color:var(--ink-muted)}
.mspark{margin-top:auto;height:32px}.mspark svg{display:block;width:100%;height:32px;overflow:visible}
.row2{display:grid;grid-template-columns:minmax(250px,1fr) minmax(0,2.4fr);gap:14px}
.gauge{position:relative;width:140px;height:140px;margin:8px auto 12px}
.gauge svg{width:140px;height:140px;transform:rotate(135deg)}
.gauge__read{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.gauge__read b{font-size:26px;font-weight:900}
.barread{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin:10px 0 6px}
.barread span:first-child{font-weight:700}
.tablewrap{overflow:auto}
.table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums;min-width:620px}
.table th{text-align:left;font-weight:500;font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted);padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
.table td{padding:12px 10px;border-bottom:1px solid var(--line-soft);color:var(--ink-soft);white-space:nowrap}
.table .num{text-align:right}.reused{color:var(--accent-text);font-weight:600}
.table i.sw{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px}
/* profiling */
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.tile{display:flex;flex-direction:column;gap:6px}
.tile span{font-size:12px;color:var(--ink-muted);display:flex;align-items:center;gap:6px}
.tile strong{font-size:28px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1.1}
.tile small{font-size:12px;color:var(--ink-muted)}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--ink-muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:9px;height:9px;border-radius:3px}
.share{display:flex;flex-direction:column;gap:6px}
.share__head{display:flex;justify-content:space-between;font-size:13px}
.share__head code{font-family:var(--mono);font-size:12px;color:var(--ink-muted)}
.share__bar{display:flex;height:26px;border-radius:8px;overflow:hidden;gap:2px}
.share__bar span{display:grid;place-items:center;font-size:11px;font-weight:700;color:#0b0b0b;min-width:0}
.charts{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.chart svg{display:block;width:100%;height:130px}
.chart__title{font-size:13px;font-weight:700;margin-bottom:10px}
.chart__foot{display:flex;justify-content:space-between;font-size:11.5px;color:var(--ink-muted);margin-top:6px}
/* expert map */
.mapwrap{position:relative;overflow:auto;border-radius:12px;background:#0b0e10;border:1px solid var(--line);padding:12px}
#mapCanvas{display:block;image-rendering:pixelated;cursor:crosshair}
.maptip{position:fixed;z-index:60;pointer-events:none;max-width:320px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--surface);box-shadow:var(--sh-pop);font-size:12.5px;line-height:1.45;color:var(--ink-soft);display:none}
.maptip b{color:var(--ink)}
.tierbar{display:flex;height:10px;border-radius:999px;overflow:hidden;gap:3px;width:min(100%,420px)}
.tierbar i{display:block;height:100%}
.maprows{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-muted);margin-top:6px}
/* models */
.hfbox{display:flex;align-items:center;gap:10px;padding:8px 8px 8px 14px;border:1.5px solid var(--line);border-radius:14px;background:var(--surface)}
.hfbox input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);font:inherit;font-size:14.5px}
.running{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.running__icon{display:grid;place-items:center;width:56px;height:56px;border-radius:16px;border:1px solid var(--line);background:var(--surface-2);flex:none}
.running__text{flex:1;min-width:220px;display:flex;flex-direction:column;gap:6px}
.running__name{font-size:20px;font-weight:900}
.facts{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:13px;color:var(--ink-muted)}
.facts b{color:var(--ink);font-weight:700}
.memstrip{display:flex;height:10px;border-radius:999px;overflow:hidden;gap:3px;width:min(100%,420px);margin-top:4px}
.memstrip i{display:block;height:100%}
.mlist{display:flex;flex-direction:column;padding:6px 20px}
.mrow{display:grid;grid-template-columns:44px minmax(0,1.4fr) minmax(0,1.3fr) 90px 130px;align-items:center;gap:16px;padding:14px 2px;border-bottom:1px solid var(--line-soft)}
.mrow:last-child{border-bottom:0}
.mrow__icon{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;border:1px solid var(--line);background:var(--surface-2);font-weight:900;font-size:13px;color:var(--ink-soft)}
.mrow__name{font-weight:700}.mrow__sub{font-size:12px;color:var(--ink-muted)}
.mrow__tags{display:flex;flex-wrap:wrap;gap:6px}.mrow__size{text-align:right;font-size:13px;color:var(--ink-soft);font-variant-numeric:tabular-nums}.mrow__act{display:flex;justify-content:flex-end}
.sectlabel{font-size:11.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted);margin:6px 0 -6px 2px}
/* settings + system one */
.form{display:grid;gap:18px}
.field{display:grid;gap:7px}
.field>label,.field>span{font-size:13px;font-weight:700;color:var(--ink-soft);display:flex;justify-content:space-between}
.field small{font-size:12px;color:var(--ink-muted);font-weight:400}
.input,.select,.area{height:40px;padding:0 12px;border:1.5px solid var(--line);border-radius:11px;background:var(--surface);color:var(--ink);font:inherit;font-size:14px;width:100%}
.area{height:auto;min-height:90px;padding:10px 12px;resize:vertical;line-height:1.5}
.input:focus,.select:focus,.area:focus{outline:0;border-color:var(--accent)}
.seg{display:inline-flex;gap:4px;padding:4px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;width:max-content}
.seg button{height:30px;padding:0 13px;border:0;border-radius:8px;background:transparent;color:var(--ink-muted);font-size:13px;font-weight:600;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.2)}
.range{width:100%;accent-color:var(--accent)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.settings-layout{display:grid;grid-template-columns:200px minmax(0,1fr);gap:24px;align-items:start}
.settings-nav{position:sticky;top:0;display:flex;flex-direction:column;gap:2px}
.settings-nav a{display:block;padding:9px 12px;border-radius:10px;color:var(--ink-soft);text-decoration:none;font-size:14px;font-weight:500}
.settings-nav a:hover{background:var(--surface-2)}
.settings-nav a[aria-current]{background:var(--surface-2);color:var(--ink)}
.kv{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.kv div{padding:12px;border:1px solid var(--line-soft);border-radius:12px;background:var(--surface-2)}
.kv b{display:block;font-size:22px;font-weight:900}.kv span{font-size:12px;color:var(--ink-muted)}
.status{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-soft)}
.status i{width:8px;height:8px;border-radius:50%;background:var(--ink-muted)}
.status[data-ok="true"] i{background:var(--accent);box-shadow:0 0 0 4px var(--accent-tint)}
.s1{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:16px;align-items:start}
.opt{display:grid;grid-template-columns:minmax(0,1fr) 60px;gap:6px 12px;align-items:center;margin-top:12px}
.opt b{font-size:14px}
.opt .num{text-align:right;font-weight:800;font-variant-numeric:tabular-nums}
.opt .progress{grid-column:1/-1;height:10px}
.s1meta{display:flex;gap:14px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-muted);margin-top:14px}
.s1meta b{color:var(--ink-soft)}
@media (max-width:1100px){.metrics,.tiles{grid-template-columns:repeat(2,minmax(0,1fr))}.row2,.charts,.s1,.grid2{grid-template-columns:1fr}.settings-layout{grid-template-columns:1fr}.settings-nav{display:none}.mrow{grid-template-columns:42px minmax(0,1fr) 110px}.mrow__tags,.mrow__size{display:none}}

/* ---------------- icon rail: always open, black */
.rail{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 0;background:var(--bg);border-right:1px solid #1d1d1d;z-index:20}
.rail__logo{display:grid;place-items:center;width:42px;height:42px;margin-bottom:12px;border-radius:12px}
.rail__logo canvas{width:40px;height:40px;image-rendering:pixelated}
.railbtn{position:relative;display:grid;place-items:center;width:42px;height:42px;border:0;border-radius:12px;background:transparent;color:var(--ink-muted);cursor:pointer;transition:background var(--dur),color var(--dur)}
.railbtn:hover{background:var(--surface-2);color:var(--ink)}
.railbtn[aria-current="page"]{background:var(--surface-2);color:var(--accent-text)}
.railbtn[aria-current="page"]::before{content:"";position:absolute;left:-7px;top:10px;bottom:10px;width:3px;border-radius:0 3px 3px 0;background:var(--accent-text)}
.railbtn::after{content:attr(data-tip);position:absolute;left:calc(100% + 12px);top:50%;transform:translateY(-50%) translateX(-4px);padding:6px 10px;border-radius:8px;background:#f0f0f0;color:#111;font-size:12.5px;font-weight:600;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .12s,transform .12s;z-index:40}
.railbtn:hover::after{opacity:1;transform:translateY(-50%)}
.rail__spacer{flex:1}

/* ---------------- real app additions */
.thinking{border:1px solid var(--line);border-radius:12px;background:var(--surface)}
.thinking>summary{list-style:none;display:flex;align-items:center;gap:8px;padding:9px 13px;cursor:pointer;font-size:13px;font-weight:500;color:var(--ink-muted)}
.thinking>summary::-webkit-details-marker{display:none}
.thinking .chev{margin-left:auto;transition:transform var(--dur)}
.thinking[open] .chev{transform:rotate(180deg)}
.thinking__body{padding:0 13px 12px;font-size:13px;color:var(--ink-muted);line-height:1.6;max-height:42vh;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin}
.thinking__body p{margin:0 0 8px}
.md{display:flex;flex-direction:column;gap:10px;line-height:1.65}
.md p{margin:0}.md ul,.md ol{margin:0;padding-left:22px;display:flex;flex-direction:column;gap:5px}
.md a{color:var(--accent-text)}
.mdh{margin:6px 0 0;font-size:16px;font-weight:800;color:var(--ink)}
h3.mdh{font-size:18px}
.codeblock{border-radius:12px;overflow:hidden;background:var(--code-bg);border:1px solid var(--line-soft)}
.codehead{display:flex;align-items:center;justify-content:space-between;padding:6px 8px 6px 14px;font-size:12px;color:#9aa3ab;border-bottom:1px solid rgba(255,255,255,.06)}
.codeblock pre{margin:0;padding:12px 14px;overflow:auto;font:400 12.5px/1.6 var(--mono);color:#e3e7ea;max-height:460px}
.sbtn--xs{height:26px;padding:0 10px;font-size:12px;border-color:rgba(255,255,255,.12);background:transparent;color:#cfd5da}
.mdtable{min-width:0}
.msgimg{display:block;max-width:240px;max-height:200px;border-radius:10px;margin-bottom:8px;border:1px solid var(--line)}
.cchip img.thumb{width:22px;height:22px;border-radius:5px;object-fit:cover}
.navsession{position:relative}
.convdel{display:none;position:absolute;right:6px;top:50%;transform:translateY(-50%);width:22px;height:22px;border:0;border-radius:6px;background:var(--surface-3);color:var(--ink-muted);cursor:pointer;font-size:15px;line-height:1}
.navsession:hover .convdel{display:block}.navsession:hover small{visibility:hidden}
.pop button:disabled{opacity:.45;cursor:not-allowed}
#panelMap{flex:1;min-height:0;overflow:auto;padding:14px;background:var(--surface);display:flex;flex-direction:column;gap:10px}
#panelMap[hidden]{display:none}
#panelMap .mapwrap{padding:8px}
.mapcv{display:block;image-rendering:pixelated;cursor:crosshair}

.ptab[hidden]{display:none}
.legend i.amber{background:rgb(255,176,64)}

.thinking .tcount{margin-left:6px;font-size:11.5px;color:var(--ink-muted);opacity:.8;font-variant-numeric:tabular-nums}
.thinking>summary:hover{color:var(--ink)}

.pop button[hidden]{display:none}

/* expert map by block */
.blocks{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.blocks--panel{grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:7px}
.blocks__wait{grid-column:1/-1;padding:30px 0;text-align:center}
.blk{--glow:0;background:#0b0e10;border:1px solid #20262b;border-radius:10px;padding:7px 7px 8px;transition:border-color .2s,box-shadow .2s}
.blk.on{border-color:rgba(255,255,255,calc(.25 + .5*var(--glow)));box-shadow:0 0 calc(4px + 14px*var(--glow)) rgba(95,215,215,calc(.15 + .45*var(--glow)))}
.blk__head{display:flex;justify-content:space-between;align-items:baseline;gap:6px;margin-bottom:6px;font-size:11px;color:#8d979f;white-space:nowrap}
.blk__head b{color:#d5dadf;font-weight:700}
.blocks--panel .blk__head{font-size:10px;margin-bottom:4px}
.blocks--panel .blk{padding:5px}
.blk__n{font-variant-numeric:tabular-nums}
.blk.on .blk__n{color:#fff}
.blk__cv{display:block;width:100%;height:auto;image-rendering:pixelated;border-radius:3px;cursor:crosshair}

.status-line[hidden]{display:none}

.mdseg{display:contents}
.jumpdown{position:absolute;left:50%;bottom:calc(100% + 12px);transform:translateX(-50%);z-index:5;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line);background:var(--surface);color:var(--ink-muted);box-shadow:var(--sh-bar);cursor:pointer}
.jumpdown:hover{color:var(--ink)}.jumpdown svg{transform:rotate(180deg)}.jumpdown[hidden]{display:none}

.livegrid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-top:4px}
.livenum{display:flex;flex-direction:column;gap:3px;padding:10px 12px;border:1px solid var(--line-soft);border-radius:12px;background:var(--surface-2);min-width:0}
.livenum span{font-size:11.5px;font-weight:600;color:var(--ink-muted)}
.livenum b{font-size:22px;font-weight:900;line-height:1.1;font-variant-numeric:tabular-nums}
.livenum small{font-size:11px;color:var(--ink-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.livechart{display:block;width:100%;height:64px;margin-top:14px}
.monsec{margin:6px 0 -4px}
@media (max-width:1100px){.livegrid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:620px){.livegrid{grid-template-columns:repeat(2,minmax(0,1fr))}}

.mach{display:flex;flex-direction:column;gap:10px}
.mach__facts{display:flex;flex-wrap:wrap;gap:8px 22px;font-size:13px;color:var(--ink-soft)}
.mach__facts span{display:inline-flex;align-items:center;gap:7px}
.mach__bench{display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px;font-size:12.5px;color:var(--ink-muted)}
.mach__bench .sbtn{margin-left:auto}
.sbtn--xs{height:26px;padding:0 9px;font-size:12px}
.mbest{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.mbest__c{display:flex;flex-direction:column;gap:8px;min-width:0}
.mbest__c.is-empty{opacity:.7}
.mbest__tier{font-size:11.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--accent-text)}
.mbest__name{font-size:17px;font-weight:800;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.mbest__why{margin:0;font-size:12.5px;color:var(--ink-muted);line-height:1.5}
.mspeed{display:inline-flex;align-items:baseline;gap:7px;cursor:help}
.mspeed b{font-size:22px;font-weight:900;font-variant-numeric:tabular-nums}
.mspeed small{font-size:11.5px;color:var(--ink-muted);border-bottom:1px dotted var(--ink-muted)}
.mrow--m{grid-template-columns:44px minmax(0,1.3fr) minmax(0,1.6fr) 80px 150px}
.tierb{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap;cursor:help;border:1px solid var(--line)}
.tierb.ok{background:var(--accent-tint);color:var(--accent-text);border-color:transparent}
.tierb.no{color:var(--ink-muted);opacity:.6;text-decoration:line-through}
.hfrow{display:flex;align-items:center;gap:14px;padding:12px 2px;border-bottom:1px solid var(--line-soft)}
.hfrow.is-off{opacity:.5}
.hfrow__main{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1}
.hfvars,#hfv{display:flex;flex-direction:column;gap:2px;padding:4px 0 12px 14px;border-bottom:1px solid var(--line-soft)}
.hfvar{display:grid;grid-template-columns:120px 130px minmax(0,1fr) 120px;align-items:center;gap:12px;padding:6px 0;font-size:13px}
.hfvar__tiers{display:flex;flex-wrap:wrap;gap:6px}
.jobrow{display:flex;flex-direction:column;gap:7px;padding:12px 2px;border-bottom:1px solid var(--line-soft)}
.jobrow:last-child{border-bottom:0}
.jobrow__head{display:flex;align-items:center;gap:10px;font-size:13.5px}
.jobrow__meta{display:flex;justify-content:space-between;font-size:12px;color:var(--ink-muted);font-variant-numeric:tabular-nums}
.jobrow__msg{font-size:12px;color:var(--ink-muted)}
@media (max-width:1100px){.mbest{grid-template-columns:1fr}.mrow--m{grid-template-columns:42px minmax(0,1fr) 120px}.hfvar{grid-template-columns:90px 1fr 110px}.hfvar__tiers{display:none}}
/* Nothing in a message may be wider than the column: long words and links wrap, code
   blocks and tables scroll inside themselves, the conversation never scrolls sideways. */
.stage{overflow-x:hidden}
.thread{min-width:0}
.msg-asst,.md,.lv-comp,.thinking,.codeblock,.tablewrap,.artifact-card{min-width:0;max-width:100%}
.msg-user,.md p,.md li,.mdh,.thinking__body,.notice{overflow-wrap:anywhere}
code.inl{overflow-wrap:anywhere;white-space:normal}
.md a{overflow-wrap:anywhere;word-break:break-all}
.tablewrap{overflow-x:auto}
.codeblock pre{max-width:100%}
.codeblock pre{white-space:pre-wrap;overflow-wrap:anywhere;overflow-x:hidden;overflow-y:auto}
.table.mdtable{min-width:0}
.mdtable th,.mdtable td{white-space:normal;overflow-wrap:anywhere}

/* web search: the steps in a message, the sources, the citations */
.wsteps{display:flex;flex-direction:column;gap:6px}
.wstep{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-muted);min-width:0}
.wstep span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wstep b{color:var(--ink-soft);font-weight:600}
.wstep small{margin-left:auto;flex:none;font-size:11.5px}
.wstep.is-err small{color:var(--del)}
.wsrc{border:1px solid var(--line-soft);border-radius:12px;padding:0 12px;font-size:13px}
.wsrc>summary{display:flex;align-items:center;gap:8px;padding:9px 0;cursor:pointer;list-style:none;color:var(--ink-muted);font-weight:600}
.wsrc>summary::-webkit-details-marker{display:none}
.wsrc .chev{margin-left:auto;transition:transform var(--dur)}.wsrc[open] .chev{transform:rotate(180deg)}
.wsrc ol{margin:0 0 10px;padding-left:22px;display:flex;flex-direction:column;gap:6px}
.wsrc li a{color:var(--accent-text);overflow-wrap:anywhere}
.wsrc li small{margin-left:8px;color:var(--ink-muted)}
a.cite{display:inline-grid;place-items:center;min-width:17px;height:17px;padding:0 4px;margin:0 1px;border-radius:6px;background:var(--accent-tint);color:var(--accent-text);font-size:10.5px;font-weight:800;text-decoration:none;vertical-align:2px}
.hint .spacer{flex:1}
.webchip{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px 0 10px;margin:0;border-radius:999px;border:1px solid transparent;background:var(--accent-tint);color:var(--accent-text);font-size:12px;font-weight:700;cursor:pointer}
.webchip[hidden]{display:none}
.webchip__x{opacity:.6}.webchip:hover .webchip__x{opacity:1}

/* agents in Settings */
.agents{display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:10px}
.agent{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 8px 12px;border:1px solid var(--line);border-radius:14px;background:var(--surface-2);color:var(--ink);cursor:pointer;font:inherit;transition:transform .12s,border-color .12s,box-shadow .12s}
.agent:hover{border-color:var(--accent);transform:translateY(-1px)}
.agent__logo{display:grid;place-items:center;width:46px;height:46px;border-radius:12px;background:var(--surface);color:var(--ink);border:1px solid var(--line-soft)}
.agent__logo svg{width:28px;height:28px;display:block}
.agent b{font-size:13.5px;font-weight:700}
.agent small{font-size:11.5px;color:var(--ink-muted)}
.agent.is-off{cursor:not-allowed;opacity:.38;filter:grayscale(1)}
.agent.is-off:hover{transform:none;border-color:var(--line)}
.agent.is-busy{box-shadow:0 0 0 2px var(--accent) inset}

</style>
