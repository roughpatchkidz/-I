  for(const [re,w] of i18nPats()){const m=t.match(re);if(m){let i=1;return s.replace(t,w.replace(/\{s\}/g,()=>tr(m[i++]??'')))}}
  for(const sep of ['\n\n','\n',' · ']){if(t.includes(sep)){const parts=t.split(sep),out=parts.map(x=>tr(x));if(out.some((x,i)=>x!==parts[i]))return s.replace(t,out.join(sep))}}
  I18N_MISS.add(nums.length?k:t);return s}
/* keys with {s} hold a name or a message from outside (an agent, a folder, an error): matched as
