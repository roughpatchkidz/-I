/* hold.c <GiB>: holds that many GiB of the device-only memory type (1 GiB blocks) until /content/hold.stop exists,
 * to see what the engine's start-up probe does beside a neighbour that holds memory on the same card.
 *   gcc -O1 -Wall -o hold hold.c -lvulkan && VK_DRIVER_FILES=<icd> ./hold 60 */
#include <vulkan/vulkan.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(int argc, char **argv) {
    int want = argc > 1 ? atoi(argv[1]) : 0, got = 0;
    VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO, .apiVersion = VK_API_VERSION_1_2};
    VkInstanceCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = &app};
    VkInstance inst;
    if (vkCreateInstance(&ii, NULL, &inst) != VK_SUCCESS) { puts("no instance"); return 1; }
    uint32_t nd = 8; VkPhysicalDevice pd[8], phys = NULL;
    vkEnumeratePhysicalDevices(inst, &nd, pd);
    for (uint32_t i = 0; i < nd && !phys; i++) {
        VkPhysicalDeviceProperties pp; vkGetPhysicalDeviceProperties(pd[i], &pp);
        if (pp.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) phys = pd[i];
    }
    if (!phys) { puts("no discrete GPU"); return 1; }
    VkPhysicalDeviceMemoryProperties mp; vkGetPhysicalDeviceMemoryProperties(phys, &mp);
    int dv = -1;
    for (uint32_t i = 0; i < mp.memoryTypeCount; i++) {
        VkMemoryPropertyFlags f = mp.memoryTypes[i].propertyFlags;
        if ((f & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) && !(f & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) && !(f & 0xC0u) && dv < 0) dv = (int)i;
    }
    if (dv < 0) { puts("no device-only type"); return 1; }
    float prio = 1.0f;
    VkDeviceQueueCreateInfo qi = {.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, .queueFamilyIndex = 0, .queueCount = 1,
                                  .pQueuePriorities = &prio};
    VkDeviceCreateInfo di = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, .queueCreateInfoCount = 1, .pQueueCreateInfos = &qi};
    VkDevice dev;
    if (vkCreateDevice(phys, &di, NULL, &dev) != VK_SUCCESS) { puts("no device"); return 1; }
    for (; got < want; got++) {
        VkMemoryAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = (VkDeviceSize)1 << 30,
                                   .memoryTypeIndex = (uint32_t)dv};
        VkDeviceMemory m;
        if (vkAllocateMemory(dev, &ai, NULL, &m) != VK_SUCCESS) break;
    }
    printf("holding %d of %d GiB of the device-only type %d\n", got, want, dv);
    fflush(stdout);
    while (access("/content/hold.stop", F_OK) != 0) sleep(1);
    return 0;
}

