// A small, inspectable memory illustration. Its parameter ratio is illustrative.
const canvas=$('#memory-canvas'),ctx=canvas.getContext('2d'),range=$('#memory-focus');let seed=1,cw=1,ch=1;
function polygon(points,fill){ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.closePath();ctx.fillStyle=fill;ctx.fill()}
function memoryDraw(){
 const paint=document.documentElement.dataset.theme==='dark'?{shadow:'#00000055',board:'#343a3e',left:'#23282b',right:'#2c3236',dot:'#707a7d'}:{shadow:'#00000018',board:'#ddddda',left:'#bcbcb9',right:'#c9c9c6',dot:'#9d9d99'};
 const dpr=Math.min(devicePixelRatio||1,2),box=canvas.getBoundingClientRect();cw=box.width;ch=box.height;canvas.width=Math.round(cw*dpr);canvas.height=Math.round(ch*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,cw,ch);
 const k=Number(range.value)/100,unit=Math.min(cw/36,ch/24),cx=cw*.5,cy=ch*.52,n=17;
 const project=(x,y,z=0)=>[cx+(x-y)*unit,cy+(x+y-16)*unit*.43-z];
 const a=project(-1,-1),b=project(17,-1),c=project(17,17),d=project(-1,17);
 ctx.save();ctx.shadowColor=paint.shadow;ctx.shadowBlur=28;ctx.shadowOffsetY=18;polygon([a,b,c,d],paint.board);ctx.restore();
 polygon([d,c,[c[0],c[1]+8],[d[0],d[1]+8]],paint.left);polygon([b,c,[c[0],c[1]+8],[b[0],b[1]+8]],paint.right);
 const active=new Set();for(let i=0;i<10;i++)active.add((i*29+seed*47)%289);
 const points=[];for(let x=0;x<n;x++)for(let y=0;y<n;y++)points.push({x,y,id:x*n+y,active:active.has(x*n+y)});
 points.sort((a,b)=>(a.x+a.y)-(b.x+b.y));
 points.forEach(p=>{const at=project(p.x,p.y),r=unit*.23;ctx.globalAlpha=p.active?1:1-k*.65;ctx.beginPath();ctx.ellipse(at[0],at[1],r,r*.5,0,0,Math.PI*2);ctx.fillStyle=paint.dot;ctx.fill();});ctx.globalAlpha=1;
 points.filter(p=>p.active).forEach(p=>{
  const z=k*Math.min(ch*.34,118),at=project(p.x,p.y,z),r=unit*.32,h=4+k*5,base=project(p.x,p.y);
  if(k>.1){ctx.globalAlpha=k*.22;ctx.fillStyle='#00a4ad';for(let i=1;i<6;i++){ctx.beginPath();ctx.arc(base[0],base[1]-z*i/6,1.2,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;}
  polygon([[at[0],at[1]-r*.5],[at[0]+r,at[1]],[at[0],at[1]+r*.5],[at[0]-r,at[1]]],'#6cc8ce');
  polygon([[at[0]-r,at[1]],[at[0],at[1]+r*.5],[at[0],at[1]+r*.5+h],[at[0]-r,at[1]+h]],'#218f99');
  polygon([[at[0],at[1]+r*.5],[at[0]+r,at[1]],[at[0]+r,at[1]+h],[at[0],at[1]+r*.5+h]],'#126975');
 });
 range.setAttribute('aria-valuetext',k<.1?'The full expert set':k>.9?'Experts selected for this token':'Highlighting selected experts within the full model');
 $('.memory-label--top').style.opacity=String(.25+k*.75);
}
let memoryManual=false;range.addEventListener('input',()=>{memoryManual=true;});$$('[data-memory],#next-token').forEach(button=>button.addEventListener('click',()=>{memoryManual=true;}));document.addEventListener('colibri-memory-scroll',event=>{if(!memoryManual){range.value=String(event.detail);memoryDraw();}});range.addEventListener('input',memoryDraw);$$('[data-memory]').forEach(b=>b.addEventListener('click',()=>{range.value=b.dataset.memory;memoryDraw()}));$('#next-token').addEventListener('click',()=>{seed++;memoryDraw()});new ResizeObserver(memoryDraw).observe(canvas);document.addEventListener('colibri-theme-change',memoryDraw);

// Model collection: one selection, searchable and keyboard navigable.
const options=$$('.model-option');let selected=10,filter='all';
const number=s=>{const m=/([\d.]+)([TMB])/.exec(s);return m?Number(m[1])*({T:1000,B:1,M:.001}[m[2]]):null};
function renderModel(index,focus=false){
 selected=index;const model=COLIBRI_MODELS[index];$('#model-sheet').hidden=false;
 options.forEach((button,i)=>{button.setAttribute('aria-selected',String(i===index));button.tabIndex=i===index?0:-1;if(focus&&i===index)button.focus()});
 $('#selected-family').textContent=model.family;$('#selected-serial').textContent=String(index+1).padStart(2,'0')+' / 21';$('#selected-name').textContent=model.name;
 $('#selected-total').textContent=model.total;$('#selected-total').classList.toggle('is-word',!number(model.total));
 $('#selected-active').textContent=number(model.active)?model.active+' active':model.active;
 $('#selected-type').textContent=model.kind==='decision'?'Decision model':model.kind==='images'?'Image generation':model.tags.includes('dense')?'Dense model':'Mixture of experts';
 $('#selected-note').textContent=model.note;$('#selected-engine').textContent=model.engine;$('#selected-doc').href='https://github.com/JustVugg/colibri/blob/main/docs/'+model.doc;$('#model-command').textContent=model.command;
 $('#selected-tags').replaceChildren(...model.tags.map(tag=>{const span=document.createElement('span');span.textContent=tag;return span}));
 const ratio=number(model.active)&&number(model.total)?number(model.active)/number(model.total):model.active==='Dense'?1:.12;
 const pixels=document.createDocumentFragment();for(let i=0;i<180;i++){const dot=document.createElement('i');if(((i*37+index*17)%180)<Math.max(3,ratio*180))dot.className='lit';pixels.append(dot)}$('#model-pixels').replaceChildren(pixels);
 $('.model-prepare').open=false;
}
function visibleOptions(){return options.filter(b=>!b.hidden)}
function applyFilters(){
 const q=$('#model-search').value.trim().toLowerCase();
 options.forEach((button,i)=>{const m=COLIBRI_MODELS[i],matches=filter==='all'||m.kind===filter||m.tags.some(t=>t.toLowerCase()===filter);button.hidden=!(matches&&(m.name+' '+m.family+' '+m.engine+' '+m.tags.join(' ')+' '+m.note).toLowerCase().includes(q))});
 const visible=visibleOptions();$('#model-count').textContent=visible.length+' of 21 entries';$('#model-empty').hidden=visible.length!==0;$('#model-sheet').hidden=visible.length===0;
 if(visible.length&&options[selected].hidden)renderModel(Number(visible[0].dataset.model));
}
options.forEach((button,index)=>{button.addEventListener('click',()=>renderModel(index));button.addEventListener('keydown',event=>{const visible=visibleOptions(),at=visible.indexOf(button);let next;if(event.key==='ArrowDown')next=(at+1)%visible.length;if(event.key==='ArrowUp')next=(at+visible.length-1)%visible.length;if(event.key==='Home')next=0;if(event.key==='End')next=visible.length-1;if(next!==undefined){event.preventDefault();renderModel(Number(visible[next].dataset.model),true);visible[next].scrollIntoView({block:'nearest'})}})});
$$('[data-filter]').forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter;$$('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));applyFilters()}));
$('#model-search').addEventListener('input',applyFilters);$('#reset-models').addEventListener('click',()=>{filter='all';$('#model-search').value='';$$('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter==='all')));applyFilters();$('#model-search').focus()});renderModel(10);applyFilters();
requestAnimationFrame(()=>{const list=$('#model-list'),button=options[selected];list.scrollTop+=button.getBoundingClientRect().top-list.getBoundingClientRect().top-list.clientHeight*.4});

