const I18N_PAT={};
function i18nPats(){if(I18N_PAT[LANG])return I18N_PAT[LANG];const D=I18N[LANG]||{},out=[];
  for(const k in D)if(k.includes('{s}'))out.push([new RegExp('^'+k.split('{s}').map(x=>x.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('(.+?)')+'$','s'),D[k]]);
  return I18N_PAT[LANG]=out}
