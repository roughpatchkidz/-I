function size(){W=c.width=innerWidth;H=c.height=innerHeight;P=Math.max(4,Math.round(Math.min(W,H)/90));
  flowers=[];const n=Math.max(5,Math.round(W/(P*22)));
  for(let i=0;i<n;i++)flowers.push({x:(i+.5)*W/n+(Math.random()-.5)*P*6,h:P*(9+Math.random()*9),ph:Math.random()*6.3,
    col:['#d75fd7','#ff8700','#ffd23f','#ff5f87','#87d7ff'][i%5]});}
addEventListener('resize',size);size();
function px(x,y,col,s=P){g.fillStyle=col;g.fillRect(Math.round(x),Math.round(y),s,s);}
const mix=(a,b,k)=>`rgb(${a.map((v,i)=>Math.round(v+(b[i]-v)*k)).join(',')})`;
function sky(t){const k=(Math.sin(t/9000)+1)/2,a=g.createLinearGradient(0,0,0,H);
  a.addColorStop(0,mix([126,200,240],[40,42,104],k));a.addColorStop(1,mix([253,236,206],[255,150,88],k));g.fillStyle=a;g.fillRect(0,0,W,H);
  const sx=W*.78,sy=H*(.16+k*.34),r=4;for(let y=-r;y<=r;y++)for(let x=-r;x<=r;x++)if(x*x+y*y<=r*r+1)px(sx+x*P,sy+y*P,mix([255,246,184],[255,122,61],k));}
function ground(){const y0=H-P*6;for(let x=0;x<W;x+=P){px(x,y0,'#3a8a40');
  for(let y=y0+P;y<H;y+=P)px(x,y,((x/P+y/P)%2)?'#276b31':'#2c7535',P);} }
function flower(f,t){const base=H-P*6,sway=Math.sin(t/900+f.ph)*P*1.6;
  for(let i=0;i<f.h;i+=P){const k=i/f.h;px(f.x+sway*k,base-i,'#3f9a46');}
  const hx=f.x+sway,hy=base-f.h;[[0,-1],[1,0],[0,1],[-1,0]].forEach(([dx,dy])=>{px(hx+dx*P,hy+dy*P,f.col);px(hx+dx*P*2,hy+dy*P*2,f.col);});
  px(hx,hy,'#ffe066');return{x:hx,y:hy};}
function bird(x,y,t,flip){const fl=(Math.floor(t/45)%2)?-P:0;
  for(let r=0;r<BIRD.length;r++)for(let q=0;q<BIRD[r].length;q++){const ch=BIRD[r][q];if(ch==='.')continue;
    const cx=flip?(10-q):q;const wy=(ch==='L'&&r<4)?fl:0;px(x+cx*P,y+r*P+wy,COL[ch]);}}
let last=0;
function frame(t){sky(t);ground();const heads=flowers.map(f=>flower(f,t));
  const i=Math.floor(t/2600)%heads.length,j=(i+1)%heads.length,k=Math.min(1,(t%2600)/1600),e=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2;
  const a=heads[i],b=heads[j],bx=a.x+(b.x-a.x)*e+P*1,by=a.y+(b.y-a.y)*e-Math.sin(e*Math.PI)*P*10-P*2+Math.sin(t/160)*P*.6;
  const flip=b.x>a.x;bird(bx-(flip?P*11:0),by-P*4,t,flip);
  if(k>=1&&Math.random()<.25)sparks.push({x:b.x+(Math.random()-.5)*P*6,y:b.y-P*2,v:-.4-Math.random()*.6,l:1});
  sparks=sparks.filter(s=>(s.l-=.015)>0);sparks.forEach(s=>{s.y+=s.v;g.globalAlpha=s.l;px(s.x,s.y,'#fff6b0',Math.max(2,P/2));g.globalAlpha=1;});
  requestAnimationFrame(frame);}
requestAnimationFrame(frame);
