def dir_bytes(path):
    tot = 0
    for dirpath, _, files in os.walk(path):
        for f in files:
            p = os.path.join(dirpath, f)
            if not os.path.islink(p):
                try:
                    tot += os.path.getsize(p)
                except OSError:
                    pass
    return tot


