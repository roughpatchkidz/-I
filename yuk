    <!-- =================== SETTINGS -->
    <section class="view" id="view-settings"><div class="page__body"><div class="wrap"><div class="settings-layout">
      <nav class="settings-nav"><a href="#st-gen">Generale</a><a href="#st-agents">Agenti</a><a href="#st-model">Modello</a><a href="#st-conn">Connessione</a><a href="#st-sys">Sistema</a></nav>
