def start(backend, models_dirs=(), state=None):
    if not _started:
        configure(backend, models_dirs, state)
        threading.Thread(target=background, daemon=True).start()
        _started.append(True)


class Handler(BaseHTTPRequestHandler):
    """alone on the engine's machine, for `coli ui --models-backend`: 127.0.0.1 only, a loopback
    Host, and on a POST the page's own header (no other site, no DNS rebinding)"""
    server_version = "colibri-models/1"

    def log_message(self, *a):
        pass

    def _send(self, code, obj):
        data = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _go(self):
        u = urllib.parse.urlsplit(self.path)
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0]   # any port: an ssh tunnel moves it
        post = self.command == "POST"
        if host not in ("127.0.0.1", "localhost") or (post and self.headers.get("X-Colibri-UI") != "1"):
            return self._send(403, {"error": "solo dalla pagina di colibri"})
        n = int(self.headers.get("Content-Length") or 0)
        if n > 65536:
            return self._send(413, {"error": "too large"})
        self._send(*handle(self.command, u.path, u.query, self.rfile.read(n) if n else b""))

    do_GET = do_POST = _go


def main():
    ap = argparse.ArgumentParser(description="the Models page's service, alone on the engine's machine")
    ap.add_argument("--backend", default=os.environ.get("COLIBRI_BACKEND", "http://127.0.0.1:8000"),
                    help="the colibri gateway (coli serve) on this machine")
    ap.add_argument("--models-dir", action="append", default=[], help="where models are (default: colibri's own folder)")
    ap.add_argument("--port", type=int, default=8791)
    a = ap.parse_args()
    start(a.backend, a.models_dir)
    srv = ThreadingHTTPServer(("127.0.0.1", a.port), Handler)
    srv.daemon_threads = True
    print("colibri models service on 127.0.0.1:%d (the gateway: %s)" % (a.port, CFG.gateway), flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()

"""The Responses API (POST /v1/responses, the only one Codex speaks since it dropped
wire_api = "chat") over colibri's chat completions: the request translated into a chat request,
the chat stream translated back into Responses events. Standard library only.

Text, reasoning and function calls. Codex's freeform tools (type "custom", apply_patch's grammar)
go to the model as a function of one string argument, "input", and come back as
custom_tool_call items; hosted tools (web search, image generation) are left out. Reasoning
items Codex sends back are not part of a chat history and are dropped."""
import http.client, json, time, uuid

MAX_BODY = 32 << 20


def _text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        out = []
        for p in content:
            if isinstance(p, dict) and p.get("type") in ("input_text", "output_text", "text", "summary_text", "reasoning_text"):
                out.append(p.get("text") or "")
            elif isinstance(p, str):
                out.append(p)
        return "".join(out)
    return "" if content is None else json.dumps(content)


def _user_content(content):
    if isinstance(content, str):
        return content
    parts, img = [], False
    for p in content or []:
        if not isinstance(p, dict):
            continue
        t = p.get("type")
        if t in ("input_text", "output_text", "text"):
            parts.append({"type": "text", "text": p.get("text") or ""})
        elif t == "input_image":
            u = p.get("image_url")
            u = u if isinstance(u, str) else (u or {}).get("url")
            if u:
                parts.append({"type": "image_url", "image_url": {"url": u}})
                img = True
    return parts if img else "".join(x["text"] for x in parts)


def to_chat(body):
    """(chat request, names of the freeform tools)"""
    msgs, tools, custom = [], [], set()
    if body.get("instructions"):
        msgs.append({"role": "system", "content": body["instructions"]})
    for t in body.get("tools") or []:
        if not isinstance(t, dict) or not t.get("name"):
            continue
        if t.get("type") == "function":
            tools.append({"type": "function", "function": {"name": t["name"], "description": t.get("description") or "",
                                                           "parameters": t.get("parameters") or {"type": "object", "properties": {}}}})
        elif t.get("type") == "custom":
            custom.add(t["name"])
            desc, fmt = t.get("description") or "", t.get("format") or {}
            if fmt.get("type") == "grammar" and fmt.get("definition"):
                desc += "\n\nThe input follows this grammar (%s):\n%s" % (fmt.get("syntax") or "lark", fmt["definition"])
            tools.append({"type": "function", "function": {"name": t["name"], "description": desc, "parameters": {
                "type": "object", "properties": {"input": {"type": "string", "description": "the tool's whole input, as the grammar says"}},
                "required": ["input"]}}})
    inp = body.get("input")
    if isinstance(inp, str):
        inp = [{"type": "message", "role": "user", "content": inp}]
    asst = None   # the assistant message that consecutive calls join
    for it in inp or []:
        if not isinstance(it, dict):
            continue
        ty = it.get("type") or ("message" if "role" in it else "")
        if ty == "message":
            role = {"developer": "system"}.get(it.get("role"), it.get("role") or "user")
            if role == "assistant":
                asst = {"role": "assistant", "content": _text_of(it.get("content"))}
                msgs.append(asst)
            else:
                asst = None
                msgs.append({"role": role, "content": _user_content(it.get("content")) if role == "user" else _text_of(it.get("content"))})
        elif ty in ("function_call", "custom_tool_call"):
            args = it.get("arguments") if ty == "function_call" else json.dumps({"input": it.get("input") or ""})
            if asst is None:
                asst = {"role": "assistant", "content": None}
                msgs.append(asst)
            asst.setdefault("tool_calls", []).append({"id": it.get("call_id") or it.get("id") or "call_" + uuid.uuid4().hex[:12],
                                                      "type": "function", "function": {"name": it.get("name") or "", "arguments": args or "{}"}})
        elif ty in ("function_call_output", "custom_tool_call_output"):
            asst = None
            out = it.get("output")
            msgs.append({"role": "tool", "tool_call_id": it.get("call_id") or "", "content": out if isinstance(out, str) else _text_of(out)})
    # the chat templates take one system message, first: the instructions and the developer
    # messages ahead of the conversation joined into it, a later one as the user's
    head, rest, started = [], [], False
    for m in msgs:
        if m["role"] == "system" and not started:
            head.append(m["content"] if isinstance(m["content"], str) else _text_of(m["content"]))
        elif m["role"] == "system":
            rest.append({"role": "user", "content": m["content"]})
        else:
            started = True
            rest.append(m)
    msgs = ([{"role": "system", "content": "\n\n".join(x for x in head if x)}] if head else []) + rest
    chat = {"model": body.get("model"), "messages": msgs, "stream": True, "stream_options": {"include_usage": True}}
    if tools:
        chat["tools"] = tools
    if body.get("tool_choice") in ("auto", "none", "required"):
        chat["tool_choice"] = body["tool_choice"]
    if body.get("parallel_tool_calls") is not None:
        chat["parallel_tool_calls"] = bool(body["parallel_tool_calls"])
    for a, b in (("max_output_tokens", "max_tokens"), ("temperature", "temperature"), ("top_p", "top_p")):
        if body.get(a) is not None:
            chat[b] = body[a]
    return chat, custom


class Events:
    """chat stream chunks in, Responses events (SSE text) out"""

    def __init__(self, model, custom):
        self.rid, self.model, self.custom = "resp_" + uuid.uuid4().hex, model, custom
        self.seq, self.items, self.n = 0, [], 0
        self.msg = self.rsn = None
        self.calls, self.usage = {}, None

    def ev(self, typ, **kw):
        kw = {"type": typ, "sequence_number": self.seq, **kw}
        self.seq += 1
        return "event: %s\ndata: %s\n\n" % (typ, json.dumps(kw))

    def response(self, status):
        r = {"id": self.rid, "object": "response", "created_at": int(time.time()), "status": status, "model": self.model,
             "output": list(self.items)}
        if status == "completed":
            u = self.usage or {}
            pt, ct = int(u.get("prompt_tokens") or 0), int(u.get("completion_tokens") or 0)
            r["usage"] = {"input_tokens": pt, "input_tokens_details": {"cached_tokens": 0}, "output_tokens": ct,
                          "output_tokens_details": {"reasoning_tokens": 0}, "total_tokens": pt + ct}
        return r

    def start(self):
        return self.ev("response.created", response=self.response("in_progress")) + \
            self.ev("response.in_progress", response=self.response("in_progress"))

    def _close_rsn(self):
        if not self.rsn:
            return ""
        r, self.rsn = self.rsn, None
        item = {"type": "reasoning", "id": r["id"], "summary": [{"type": "summary_text", "text": r["text"]}]}
        self.items.append(item)
        return self.ev("response.reasoning_summary_text.done", item_id=r["id"], output_index=r["i"], summary_index=0, text=r["text"]) + \
            self.ev("response.output_item.done", output_index=r["i"], item=item)

    def _close_msg(self):
        if not self.msg:
            return ""
        m, self.msg = self.msg, None
        part = {"type": "output_text", "text": m["text"], "annotations": []}
        item = {"type": "message", "id": m["id"], "role": "assistant", "status": "completed", "content": [part]}
        self.items.append(item)
        return self.ev("response.output_text.done", item_id=m["id"], output_index=m["i"], content_index=0, text=m["text"]) + \
            self.ev("response.content_part.done", item_id=m["id"], output_index=m["i"], content_index=0, part=part) + \
            self.ev("response.output_item.done", output_index=m["i"], item=item)

    def chunk(self, d):
        out = []
        if isinstance(d.get("usage"), dict):
            self.usage = d["usage"]
        for ch in d.get("choices") or []:
            delta = ch.get("delta") or {}
            r = delta.get("reasoning_content") or delta.get("reasoning")
            if isinstance(r, str) and r:
                if not self.rsn:
                    out.append(self._close_msg())
                    self.rsn = {"id": "rs_" + uuid.uuid4().hex, "i": self.n, "text": ""}
                    self.n += 1
                    out.append(self.ev("response.output_item.added", output_index=self.rsn["i"],
                                       item={"type": "reasoning", "id": self.rsn["id"], "summary": []}))
                    out.append(self.ev("response.reasoning_summary_part.added", item_id=self.rsn["id"], output_index=self.rsn["i"],
                                       summary_index=0, part={"type": "summary_text", "text": ""}))
                self.rsn["text"] += r
                out.append(self.ev("response.reasoning_summary_text.delta", item_id=self.rsn["id"], output_index=self.rsn["i"],
                                   summary_index=0, delta=r))
            c = delta.get("content")
            if isinstance(c, str) and c:
                out.append(self._close_rsn())
                if not self.msg:
                    self.msg = {"id": "msg_" + uuid.uuid4().hex, "i": self.n, "text": ""}
                    self.n += 1
                    out.append(self.ev("response.output_item.added", output_index=self.msg["i"],
                                       item={"type": "message", "id": self.msg["id"], "role": "assistant", "status": "in_progress", "content": []}))
                    out.append(self.ev("response.content_part.added", item_id=self.msg["id"], output_index=self.msg["i"], content_index=0,
                                       part={"type": "output_text", "text": "", "annotations": []}))
                self.msg["text"] += c
                out.append(self.ev("response.output_text.delta", item_id=self.msg["id"], output_index=self.msg["i"], content_index=0, delta=c))
            for tc in delta.get("tool_calls") or []:
                e = self.calls.setdefault(tc.get("index", 0), {"id": None, "name": "", "args": ""})
                if tc.get("id"):
                    e["id"] = tc["id"]
                fn = tc.get("function") or {}
                if fn.get("name"):
                    e["name"] = fn["name"] if not e["name"] else e["name"]
                e["args"] += fn.get("arguments") or ""
        return "".join(out)

    def finish(self):
        out = [self._close_rsn(), self._close_msg()]
        for idx in sorted(self.calls):
            e = self.calls[idx]
            cid, iid, i = e["id"] or "call_" + uuid.uuid4().hex[:12], "fc_" + uuid.uuid4().hex, self.n
            self.n += 1
            if e["name"] in self.custom:
                try:
                    raw = json.loads(e["args"] or "{}").get("input", "")
                except (ValueError, AttributeError):
                    raw = e["args"]
                item = {"type": "custom_tool_call", "id": iid, "call_id": cid, "name": e["name"], "input": raw if isinstance(raw, str) else json.dumps(raw)}
                out.append(self.ev("response.output_item.added", output_index=i, item=dict(item, input="")))
                out.append(self.ev("response.custom_tool_call_input.delta", item_id=iid, output_index=i, delta=item["input"]))
                out.append(self.ev("response.custom_tool_call_input.done", item_id=iid, output_index=i, input=item["input"]))
            else:
                item = {"type": "function_call", "id": iid, "call_id": cid, "name": e["name"], "arguments": e["args"] or "{}", "status": "completed"}
                out.append(self.ev("response.output_item.added", output_index=i, item=dict(item, arguments="", status="in_progress")))
                out.append(self.ev("response.function_call_arguments.delta", item_id=iid, output_index=i, delta=item["arguments"]))
                out.append(self.ev("response.function_call_arguments.done", item_id=iid, output_index=i, arguments=item["arguments"]))
            self.items.append(item)
            out.append(self.ev("response.output_item.done", output_index=i, item=item))
        out.append(self.ev("response.completed", response=self.response("completed")))
        return "".join(out)


def serve(h, backend):
    """POST /v1/responses on handler h, against the colibri gateway at `backend` (a parsed URL)"""
    n = int(h.headers.get("Content-Length") or 0)
    if n <= 0 or n > MAX_BODY:
        return _err(h, 413 if n > MAX_BODY else 400, "request body missing or too large")
    try:
        body = json.loads(h.rfile.read(n))
        chat, custom = to_chat(body)
    except (ValueError, TypeError, AttributeError) as e:
        return _err(h, 400, "not a Responses request: %s" % e)
    headers = {"Content-Type": "application/json"}
    if h.headers.get("Authorization"):
        headers["Authorization"] = h.headers["Authorization"]
    conn = http.client.HTTPConnection(backend.hostname, backend.port or 80, timeout=3600)
    try:
        conn.request("POST", "/v1/chat/completions", body=json.dumps(chat), headers=headers)
        resp = conn.getresponse()
    except OSError as e:
        conn.close()
        return _err(h, 502, "colibri non risponde su %s: %s" % (backend.netloc, e))
    if resp.status != 200:
        msg = resp.read().decode("utf-8", "replace")[:2000]
        conn.close()
        return _err(h, resp.status, msg)
    ev = Events(body.get("model") or chat.get("model") or "colibri", custom)
    streaming = body.get("stream", False)
    if streaming:
        h.send_response(200)
        h.send_header("Content-Type", "text/event-stream")
        h.send_header("Cache-Control", "no-store")
        h.send_header("Transfer-Encoding", "chunked")
        h.end_headers()

    def send(s):
        if streaming and s:
            b = s.encode()
            h.wfile.write(b"%x\r\n%s\r\n" % (len(b), b))
            h.wfile.flush()
    try:
        send(ev.start())
        buf = b""
        while True:
            chunk = resp.read1(65536)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.strip()
                if not line.startswith(b"data:"):
                    continue
                data = line[5:].strip()
                if data == b"[DONE]":
                    continue
                try:
                    send(ev.chunk(json.loads(data)))
                except ValueError:
                    continue
        send(ev.finish())
        if streaming:
            h.wfile.write(b"0\r\n\r\n")
            h.wfile.flush()
        else:
            out = json.dumps(ev.response("completed")).encode()
            h.send_response(200)
            h.send_header("Content-Type", "application/json")
            h.send_header("Content-Length", str(len(out)))
            h.end_headers()
            h.wfile.write(out)
    except (BrokenPipeError, ConnectionResetError):
        pass   # Codex went away: closing upstream stops the engine
    finally:
        conn.close()


def _err(h, code, msg):
    b = json.dumps({"error": {"message": msg, "type": "invalid_request_error" if code < 500 else "server_error"}}).encode()
    h.send_response(code)
    h.send_header("Content-Type", "application/json")
    h.send_header("Content-Length", str(len(b)))
    h.end_headers()
    h.wfile.write(b)

#!/usr/bin/env python3
"""The server of colibri's chat UI: serves index.html and passes the API calls
through to a colibri gateway (`coli serve`), so the page and the API share one
origin (the gateway sends no CORS headers). Standard library only.

    python3 ui/server.py [--port 8790] [--backend http://127.0.0.1:8000]
    coli ui                       (the same, the backend `coli serve`'s default)

Besides the proxy it answers /agents (ui/agents.py: a coding agent opened in a
new terminal window, pointed at colibri) and /v1/responses (ui/responses_shim.py:
the Responses API over the gateway's chat API, for agents that speak only that).
/web/ is the chat's web search (ui/web.py: SearXNG with --searx, else DuckDuckGo).
/models/ is the Models page (ui/models.py): in this process when the gateway is on
this machine, else a models service on the engine's machine (--models-backend);
with neither it answers 404 and the page says the feature is not available.

Streams (chat in SSE) are passed through chunk by chunk; when the browser goes
away the upstream connection is closed, so the gateway stops the engine."""
import argparse, http.client, json, os, sys, urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import agents, responses_shim, web   # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
PROXIED = ("/v1/", "/health", "/profile", "/experts")
MODELS = "/models/"   # the Models page: what fits this machine, search, download and switch models
HOP = {"connection", "keep-alive", "transfer-encoding", "te", "trailer", "upgrade", "proxy-authorization", "proxy-authenticate", "host", "content-length"}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    backend = None
    models_backend = None   # a models service elsewhere (--models-backend)
    models = None           # ui/models.py in this process (the gateway is on this machine)
    port = 8790

    def _json(self, code, obj):
        b = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def _local_ok(self, post):
        """/agents only for this page: its own Host and Origin (no DNS rebinding, no other site),
        and on a POST a header of its own, which a page elsewhere cannot send without a CORS
        preflight this server never grants"""
        hosts = {"127.0.0.1:%d" % self.port, "localhost:%d" % self.port}
        if self.headers.get("Host") not in hosts:
            return False
        origin = self.headers.get("Origin")
        if origin is not None and origin not in {"http://" + h for h in hosts}:
            return False
        if post and (self.headers.get("X-Colibri-UI") != "1" or not (self.headers.get("Content-Type") or "").startswith("application/json")):
            return False
        return True

    def _agents(self, path):
        post = self.command == "POST"
        if not self._local_ok(post):
            return self._json(403, {"error": "solo dalla pagina di colibri su questa macchina"})
        if path == "/agents" and not post:
            return self._json(200, agents.detect())
        if path == "/agents/refresh" and post:
            return self._json(200, agents.detect(force=True))
        if path == "/agents/launch" and post:
            n = int(self.headers.get("Content-Length") or 0)
            if n <= 0 or n > 4096:
                return self._json(400, {"ok": False, "message": "richiesta non valida"})
            try:
                req = json.loads(self.rfile.read(n))
                assert isinstance(req, dict)
            except (ValueError, AssertionError):
                return self._json(400, {"ok": False, "message": "richiesta non valida"})
            backend = "%s://%s" % (self.backend.scheme, self.backend.netloc)
            ok, msg = agents.launch(req.get("agent"), req.get("model"), req.get("folder"), req.get("key") or "",
                                    backend, "http://127.0.0.1:%d" % self.port)
            return self._json(200 if ok else 400, {"ok": ok, "message": msg})
        return self._json(404, {"error": "no such route"})

    def log_message(self, fmt, *args):
        sys.stderr.write("[ui] %s - %s\n" % (self.address_string(), fmt % args))

    def _static(self):
        path = urllib.parse.urlparse(self.path).path
        name = "index.html" if path in ("/", "/index.html") else None
        if name is None:
            self.send_error(404)
            return
        with open(os.path.join(HERE, name), "rb") as f:
            body = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _proxy(self, u=None):
        u = u or self.backend
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP and k.lower() != "origin"}
        conn = http.client.HTTPConnection(u.hostname, u.port or 80, timeout=3600)
        try:
            conn.request(self.command, self.path, body=body, headers=headers)
            resp = conn.getresponse()
        except OSError as e:
            msg = ('{"error":{"message":"colibri non risponde su %s: %s"}}' % (u.netloc, e)).encode()
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(msg)))
            self.end_headers()
            self.wfile.write(msg)
            return
        self.send_response(resp.status, resp.reason)
        for k, v in resp.getheaders():
            if k.lower() not in HOP:
                self.send_header(k, v)
        self.send_header("Transfer-Encoding", "chunked")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            while True:
                chunk = resp.read1(65536)
                if not chunk:
                    break
                self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk))
                self.wfile.flush()
            self.wfile.write(b"0\r\n\r\n")
            self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass  # the page stopped the request: closing upstream cancels the engine
        finally:
            conn.close()

    def _web(self, path):
        """the chat's web search: /web/status, /web/search?q=&n=, /web/page?url=&max="""
        if not self._local_ok(False):
            return self._json(403, {"error": "solo dalla pagina di colibri su questa macchina"})
        q = dict(urllib.parse.parse_qsl(urllib.parse.urlparse(self.path).query))
        try:
            if path == "/web/status":
                return self._json(200, web.status())
            if path == "/web/search":
                return self._json(200, web.search(q.get("q", ""), int(q.get("n", 6))))
            if path == "/web/page":
                return self._json(200, web.page(q.get("url", ""), int(q.get("max", 5000))))
        except ValueError as e:
            return self._json(400, {"error": str(e)})
        except Exception as e:   # noqa: BLE001 - the network's errors, said to the page
            return self._json(502, {"error": "%s: %s" % (type(e).__name__, e)})
        return self._json(404, {"error": "no such route"})

    def _models(self):
        """the Models page: only for this page, like /agents (it downloads and restarts the server)"""
        post = self.command == "POST"
        if not self._local_ok(post):
            return self._json(403, {"error": "solo dalla pagina di colibri su questa macchina"})
        if self.models_backend is not None:
            return self._proxy(self.models_backend)
        if self.models is None:
            return self._json(404, {"error": {"message": "no models service on this server (--models-backend)"}})
        n = int(self.headers.get("Content-Length") or 0)
        if n > 65536:
            return self._json(413, {"error": "richiesta troppo grande"})
        u = urllib.parse.urlparse(self.path)
        code, obj = self.models.handle(self.command, u.path, u.query, self.rfile.read(n) if n else b"")
        return self._json(code, obj)

    def _route(self):
        path = urllib.parse.urlparse(self.path).path
        if path.startswith("/web/") and self.command == "GET":
            self._web(path)
        elif path == "/v1/responses" and self.command == "POST":
            responses_shim.serve(self, self.backend)   # Codex: the Responses API over colibri's chat API
        elif path == "/agents" or path.startswith("/agents/"):
            self._agents(path)
        elif path.startswith(PROXIED):
            self._proxy()
        elif path.startswith(MODELS):
            self._models()
        elif self.command == "GET":
            self._static()
        else:
            self.send_error(405)

    do_GET = do_POST = do_DELETE = do_PUT = _route

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Content-Length", "0")
        self.end_headers()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8790)
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--backend", default=os.environ.get("COLIBRI_BACKEND", "http://127.0.0.1:8000"),
                    help="the colibri gateway (coli serve)")
    ap.add_argument("--models-backend", default=os.environ.get("COLIBRI_MODELS_BACKEND", ""),
                    help="the models service on the engine's machine (python3 ui/models.py there), "
                         "when the gateway is elsewhere")
    ap.add_argument("--models-dir", action="append", default=[],
                    help="where models are, for the Models page (default: colibri's own folder)")
    ap.add_argument("--searx", default=os.environ.get("COLIBRI_SEARX", ""),
                    help="a SearXNG instance for web search (default: DuckDuckGo's HTML results)")
    a = ap.parse_args()
    web.SEARX = a.searx
    Handler.backend = urllib.parse.urlparse(a.backend)
    Handler.models_backend = urllib.parse.urlparse(a.models_backend) if a.models_backend else None
    Handler.port = a.port
    if not a.models_backend and Handler.backend.hostname in ("127.0.0.1", "localhost", "::1"):
        try:   # the gateway is on this machine: the Models page is served from here
            import models
            models.start(a.backend, a.models_dir)
            Handler.models = models
        except Exception as e:   # noqa: BLE001 - a tree without colibri's setup modules: no Models page
            print("colibri UI: no Models page (%s: %s)" % (type(e).__name__, e), file=sys.stderr)
    srv = ThreadingHTTPServer((a.host, a.port), Handler)
    srv.daemon_threads = True
    print("colibri UI: http://%s:%d  (the gateway: %s)" % (a.host, a.port, a.backend), flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()

"""Web search for the chat (the page's search step): results for a query, then the readable text
of the pages the model chooses to open. Standard library only.

The results come from a SearXNG instance when one is named (--searx URL or COLIBRI_SEARX),
else from DuckDuckGo's plain HTML page, which needs no key. What the model reads is short on
purpose: every character is prompt the engine has to read.

A page is opened only at a public address (no loopback, private, link-local or reserved one,
redirects checked the same way), so a page the model asks for cannot reach this machine's own
services or its network."""
import html
import ipaddress
import json
import re
import socket
import urllib.parse
import urllib.request
from html.parser import HTMLParser

UA = "Mozilla/5.0 (colibri local search)"
SEARX = ""   # set by server.py from --searx


def status():
    """{"search": bool, "engine": name}: SearXNG when it answers, else DuckDuckGo"""
    if SEARX:
        try:
            with urllib.request.urlopen(SEARX.rstrip("/") + "/healthz", timeout=3) as r:
                if r.status == 200:
                    return {"search": True, "engine": "searxng"}
        except Exception:   # noqa: BLE001 - a down SearXNG falls back below
            pass
    return {"search": True, "engine": "duckduckgo"}


def _clean(s, n):
    return re.sub(r"\s+", " ", html.unescape(s or "")).strip()[:n]


def _searx(q, n):
    url = SEARX.rstrip("/") + "/search?" + urllib.parse.urlencode({"q": q, "format": "json", "language": "all"})
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": UA}), timeout=15) as r:
        data = json.load(r)
    out, seen = [], set()
    for x in data.get("results") or []:
        u = x.get("url")
        if not u or u in seen:
            continue
        seen.add(u)
        out.append({"title": _clean(x.get("title"), 160), "url": u, "snippet": _clean(x.get("content"), 320),
                    "engine": x.get("engine"), "date": (x.get("publishedDate") or "")[:10] or None})
        if len(out) >= n:
            break
    answers = [a if isinstance(a, str) else a.get("answer", "") for a in (data.get("answers") or [])][:2]
    return out, answers


class _DDG(HTMLParser):
    """result__a links (title, href) and result__snippet texts of DuckDuckGo's HTML page"""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.rows, self.cur, self.mode = [], None, None

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        cls = a.get("class") or ""
        if tag == "a" and "result__a" in cls.split():
            self.cur = {"title": "", "url": a.get("href") or "", "snippet": ""}
            self.rows.append(self.cur)
            self.mode = "title"
        elif "result__snippet" in cls.split() and self.cur is not None:
            self.mode = "snippet"

    def handle_endtag(self, tag):
        if tag in ("a", "td", "div"):
            self.mode = None

    def handle_data(self, data):
        if self.cur is not None and self.mode:
            self.cur[self.mode] += data


def _ddg_url(u):
    """DuckDuckGo's redirect links (//duckduckgo.com/l/?uddg=...) to the address they name"""
    if u.startswith("//"):
        u = "https:" + u
    p = urllib.parse.urlsplit(u)
    if p.hostname and p.hostname.endswith("duckduckgo.com") and p.path.startswith("/l/"):
        return urllib.parse.parse_qs(p.query).get("uddg", [u])[0]
    return u


def _duckduckgo(q, n):
    body = urllib.parse.urlencode({"q": q}).encode()
    req = urllib.request.Request("https://html.duckduckgo.com/html/", data=body,
                                 headers={"User-Agent": UA, "Content-Type": "application/x-www-form-urlencoded"})
    with urllib.request.urlopen(req, timeout=15) as r:
        page = r.read(2 << 20).decode("utf-8", errors="replace")
    p = _DDG()
    p.feed(page)
    out, seen = [], set()
    for row in p.rows:
        u = _ddg_url(row["url"])
        if not u.startswith(("http://", "https://")) or u in seen:
            continue
        host = urllib.parse.urlsplit(u).hostname or ""
        if host.endswith("duckduckgo.com"):   # its ads go through its own links
            continue
        seen.add(u)
        out.append({"title": _clean(row["title"], 160), "url": u, "snippet": _clean(row["snippet"], 320),
                    "engine": "duckduckgo", "date": None})
        if len(out) >= n:
            break
    return out, []


def search(q, n=6):
    q = (q or "").strip()[:400]
    if not q:
        raise ValueError("an empty query")
    n = max(1, min(int(n), 10))
    results, answers = _searx(q, n) if status()["engine"] == "searxng" else _duckduckgo(q, n)
    return {"q": q, "results": results, "answers": answers}


def _public_url(url):
    """http(s) to a public address only"""
    u = urllib.parse.urlsplit(url)
    if u.scheme not in ("http", "https") or not u.hostname:
        raise ValueError("http and https links only")
    for info in socket.getaddrinfo(u.hostname, u.port or (443 if u.scheme == "https" else 80)):
        ip = ipaddress.ip_address(info[4][0].split("%")[0])
        if not ip.is_global:
            raise ValueError("not a public address: %s" % u.hostname)
    return url


class _CheckedRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        _public_url(newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


class _Text(HTMLParser):
    """Readable text of a page: whole subtrees that are navigation, menus, language lists,
    cookie banners or hidden are skipped (by tag, role, class or id), <article>/<main> kept apart."""
    SKIP = {"script", "style", "noscript", "svg", "template", "iframe", "nav", "footer", "form", "button",
            "select", "aside", "header"}
    VOID = {"br", "img", "input", "meta", "link", "hr", "area", "base", "col", "embed", "source", "track", "wbr", "param"}
    BLOCK = {"p", "div", "br", "li", "h1", "h2", "h3", "h4", "h5", "h6", "tr", "section", "article", "pre", "blockquote"}
    NAV = re.compile(r"(^|[\s_-])(nav|navbar|navbox|menu|sidebar|footer|cookie|cookies|banner|portlet|interlanguage|"
                     r"toc|share|breadcrumbs?|related|advert|ads|lang|languages|catlinks|printfooter)([\s_-]|$)", re.I)

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack, self.main, self.title_on = [], 0, False
        self.all, self.inmain, self.title = [], [], ""

    def _nl(self):
        self.all.append("\n")
        if self.main:
            self.inmain.append("\n")

    def handle_starttag(self, tag, attrs):
        if tag == "title":
            self.title_on = True
        if tag in self.VOID:
            if tag == "br" and not self.stack:
                self._nl()
            return
        if self.stack:
            self.stack.append(tag)
            return
        a = dict(attrs)
        mark = "%s %s" % (a.get("class") or "", a.get("id") or "")
        outer = tag in ("html", "body", "main", "article")      # their classes describe the page, not a menu
        if (tag in self.SKIP or (a.get("role") or "") in ("navigation", "banner", "contentinfo", "menu", "search")
                or (not outer and (self.NAV.search(mark) or a.get("aria-hidden") == "true" or "hidden" in a))):
            if tag != "header" or not self.main:      # a header inside the article is its title
                self.stack = [tag]
                return
        if tag in ("article", "main"):
            self.main += 1
        if tag in self.BLOCK:
            self._nl()

    def handle_endtag(self, tag):
        if tag == "title":
            self.title_on = False
        if self.stack:
            if tag in self.stack:
                while self.stack and self.stack.pop() != tag:
                    pass
            return
        if tag in ("article", "main") and self.main:
            self.main -= 1
        if tag in self.BLOCK:
            self._nl()

    def handle_data(self, data):
        if self.title_on:
            self.title += data
            return
        if self.stack:
            return
        self.all.append(data)
        if self.main:
            self.inmain.append(data)


def page(url, max_chars=5000):
    """The readable text of one page: the <article>/<main> part when it has one, else the
    whole body, scripts and navigation dropped, cut to max_chars."""
    _public_url(url)
    max_chars = max(200, min(int(max_chars), 20000))
    opener = urllib.request.build_opener(_CheckedRedirect)
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "text/html,text/plain;q=0.9"})
    with opener.open(req, timeout=10) as r:
        ctype = r.headers.get("Content-Type", "")
        if "html" not in ctype and "text/plain" not in ctype:
            raise ValueError("not a text page (%s)" % (ctype or "unknown type"))
        raw = r.read(3 << 20)
        final = r.geturl()
    charset = re.search(r"charset=([\w-]+)", ctype)
    text = raw.decode(charset.group(1) if charset else "utf-8", errors="replace")
    title = ""
    if "html" in ctype:
        p = _Text()
        p.feed(text)
        main = "".join(p.inmain)
        text = main if len(main.strip()) > 600 else "".join(p.all)
        title = p.title.strip()
    text = re.sub(r"[ \t\r\f\v]+", " ", text)
    text = re.sub(r"\s*\n\s*", "\n", text).strip()
    return {"url": final, "title": title[:200], "text": text[:max_chars], "truncated": len(text) > max_chars,
            "chars": len(text)}
# colibrì web

React/Vite interface for an OpenAI-compatible colibrì server.

```sh
npm install
npm run dev
```

The default endpoint is `http://127.0.0.1:8000/v1`. Start the API server from
PR #21 (or any compatible backend), then use **Probe server** to load its models.

Local validation:

```sh
npm test
npm run build
```

Besides Chat and Brain, the **Profiling** tab charts where the engine spent
each turn's wall time (I/O wait, expert matmul, attention, LM head) from the
server's `/profile` endpoint — a rolling window of per-turn `PROF` snapshots
emitted by the engine.

When `/v1/models` marks the selected model with `"capabilities":
["image_generation"]` (Qwen-Image-2.1 under `coli serve`), the chat view
generates pictures instead of text. The composer then offers size presets
(every side a multiple of 32, from 256 to 2048) or a custom size, the number of
denoising steps and a seed; an empty seed draws a new random one for every
picture. The request goes to `POST /v1/images/generations` with `"stream":
true`: the turn shows the stage (encoding the prompt, denoising step k of N,
decoding), the elapsed time and, when the engine sends them, blurred previews.
If the stream never starts, the same request is made once without it. A
finished picture carries its size, steps, seed and time, and can be downloaded
as PNG, have its seed copied, or be made again with a new seed. Image turns
stay on screen when you switch back to a text model but are never sent to it.

The test suite stays browser-light: API requests use a mocked `fetch`, while
runtime capability and storage behavior are covered through pure helpers. It
checks that `/health` and `/profile` are resolved next to (not below) the OpenAI `/v1` prefix,
supports both boolean and numeric `scheduler.active` responses, and sends the
colibrì-specific `cache_slot` field only when KV-slot support was advertised.

The endpoint and selected model are persisted locally. API keys are intentionally
memory-only; startup/persistence also removes the legacy `colibri.apiKey` value.

