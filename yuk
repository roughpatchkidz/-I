function statsHTML(s){if(!s)return '';const p=[],ap=s.approx?'~':'';if(s.tps)p.push(`<span><b>${ap}${fmt(s.tps)}</b> tok/s</span>`);if(s.out!=null)p.push(`<span><b>${ap}${nf(s.out)}</b> token scritti</span>`);if(s.prompt!=null)p.push(`<span><b>${nf(s.prompt)}</b> token di prompt</span>`);if(s.ttft!=null)p.push(`<span>primo token dopo <b>${fmt(s.ttft)} s</b></span>`);return `<div class="msg-stats">${p.join('')}</div>`}
function actionsHTML(last){return `<div class="msg-actions"><button class="btn-icon" data-act="copy" title="Copia risposta"><svg class="ic ic--sm"><use href="#i-copy"/></svg></button>${last?`<button class="btn-icon" data-act="regen" title="Rigenera risposta"><svg class="ic ic--sm"><use href="#i-retry"/></svg></button>${HEALTH&&HEALTH.continue_assistant?`<button class="btn-icon" data-act="cont" title="Continua questa risposta"><svg class="ic ic--sm"><use href="#i-cont"/></svg></button>`:''}`:''}</div>`}
function asstInner(msg,last,live){const arts=[];let h='';CITE=msg.sources||null;
  if(msg.compaction)h+=`<div class="notice"><svg class="ic ic--sm"><use href="#i-layers"/></svg><span>I primi <b>${msg.compaction.summarized_messages} messaggi</b> non entravano più nel contesto del modello: sono stati riassunti e la conversazione continua dal riassunto.</span></div>`;
  if(msg.reasoning&&!live)h+=`<details class="thinking" ${msg.thinkOpen?'open':''}><summary><svg class="ic ic--sm"><use href="#i-bulb"/></svg><span class="tlabel">Ragionamento</span><small class="tcount">${nf(msg.reasoning.length)} caratteri</small><svg class="ic ic--sm chev"><use href="#i-chev"/></svg></summary><div class="thinking__body">${mdBlock(msg.reasoning)}</div></details>`;
  h+=stepsHTML(msg);
  if(live&&!msg.content&&!msg.reasoning)h+=`<div class="status-line"><span class="dots"><i></i><i></i><i></i></span>${phase==='queued'?'In coda':'Legge il prompt'}</div>`;
