function pick(a){return a[Math.floor(Math.random()*a.length)]}
function zz(){const z=document.createElement('span');z.className='zz';z.textContent='z';z.style.left=(M.x+BOX-14)+'px';z.style.bottom=(BOX*.55)+'px';cwrap.appendChild(z);setTimeout(()=>z.remove(),2500)}
