.contact-hero{--paper:#e6e6e6;--carbon:#252525;position:relative;isolation:isolate;overflow:hidden;height:100svh;min-height:760px;max-height:1120px;background:var(--paper);color:var(--carbon);font-family:Geist,Arial,sans-serif}
.contact-grain{position:absolute;inset:0;width:100%;height:100%;opacity:.055;pointer-events:none;z-index:5;mix-blend-mode:multiply}
.contact-intro{position:absolute;left:4.5%;top:6.7%;margin:0;max-width:420px;font-size:clamp(31px,3.3vw,52px);line-height:1.08;font-weight:440;letter-spacing:-1.9px;z-index:4}
.contact-intro span{display:block;color:#939393}
.contact-art{position:absolute;top:19%;left:50%;width:max(112%,1280px);height:auto;transform:translateX(-50%);overflow:visible;color:#656565;pointer-events:none;z-index:1}
.contact-hand{fill:currentColor}
.contact-hand{transform-box:fill-box;transform-origin:center;will-change:transform}
.contact-wordmark{position:absolute;bottom:12%;left:4.5%;width:91%;aspect-ratio:7.5;height:auto;margin:0;z-index:0;color:#282828;pointer-events:none}
.contact-wordmark svg{width:100%;height:100%}
.contact-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none}
.bird-flat{transition:opacity .25s}
.contact-hero[data-renderer="webgl"] .bird-flat{opacity:0}
.contact-trigger{position:absolute;left:50%;top:36%;width:190px;height:240px;transform:translate(-50%,-50%);padding:0;background:transparent;border:0;border-radius:30%;z-index:6;cursor:grab;touch-action:none;-webkit-tap-highlight-color:transparent;color:var(--carbon)}
.contact-trigger:active{cursor:grabbing}.contact-trigger:focus-visible{outline:1px dashed #525252;outline-offset:10px}
.contact-gesture{position:absolute;left:50%;top:63%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;z-index:4;pointer-events:none;white-space:nowrap}
.contact-gesture .press-dot{width:6px;height:6px;border-radius:50%;background:#5a5a5a;transform:scale(calc(1 + var(--contact,0)*.6));opacity:calc(.4 + var(--contact,0)*.6)}
.contact-hint{font-size:10px;line-height:1.4;letter-spacing:.15px;color:#767676;text-align:center}
.contact-hero[data-connected="true"] .press-dot{background:#666666}
.contact-footer{position:absolute;bottom:4.5%;left:4.5%;right:4.5%;z-index:4;display:flex;justify-content:space-between;align-items:flex-end;gap:30px}
.contact-footer p{margin:0;font-size:11px;line-height:1.7;font-weight:400;color:#757575}
.contact-footer p strong{display:block;font-weight:500;color:#434343}
.contact-link{display:inline-flex;align-items:center;gap:28px;font-size:11px;line-height:1.5;color:#434343;text-decoration:none;padding:9px 0}
.contact-link svg{width:16px;height:16px;stroke:currentColor;stroke-width:1.3;fill:none;transition:transform .2s}
.contact-link:hover svg{transform:translate(3px,-3px)}
.contact-motion{position:absolute;right:4.5%;top:7%;z-index:7;width:30px;height:30px;display:grid;place-items:center;border:0;background:none;color:#868686;cursor:pointer}
.contact-motion svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.5}.contact-motion:hover{color:#272727}
.contact-hero .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
