const I18N_MISS=new Set();window.__i18nMiss=I18N_MISS;
const I18N_NUM=/\d+(?:[.,]\d+)*/g;
function tr(s){
  if(LANG==='it'||!s)return s;const D=I18N[LANG];if(!D)return s;
  const t=s.trim();if(!t||!/\p{L}/u.test(t))return s;
  let v=D[t];if(v!=null)return s.replace(t,v);
