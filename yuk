  arts.forEach((code,k)=>{h+=`<div class="artifact-card"><span class="filetag">HTML</span><span class="artifact-card__text"><b>pagina${arts.length>1?'-'+(k+1):''}.html</b><small>${nf(Math.round(code.length/102.4)/10)} KB</small></span><button class="openbtn" data-art="${k}">Apri</button></div>`});
  if(msg.finish==='length')h+=`<span class="trunc" title="La risposta ha raggiunto la fine del contesto del modello (o il limite che hai messo nelle impostazioni) ed è stata tagliata: Continua la riprende da dove si è fermata.">Troncato</span>`;
  if(msg.finish==='aborted')h+=`<p class="muted" style="font-size:13.5px;margin:0">Risposta fermata.</p>`;
  if(msg.finish==='incomplete')h+=`<p class="muted" style="font-size:13.5px;margin:0">Il flusso si è chiuso prima della fine.</p>`;
  if(msg.error)h+=`<div class="notice" style="border-color:var(--del);color:var(--del)">${esc(msg.error)}</div>`;
