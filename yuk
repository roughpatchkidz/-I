function renderAgents(){
  const g=$('#agentsGrid');if(!g)return;
  $('#agentModel').value=model?pretty(model):tr('prima scegli un modello');
  if(document.activeElement!==$('#agentDir'))$('#agentDir').value=ST.agentDir||'';
  const list=(AGENTS&&AGENTS.agents)||[];
  g.innerHTML=list.map(a=>{const on=a.installed&&a.wired;
    const sub=!a.installed?'non installato':!a.wired?'non ancora collegabile':(a.where==='wsl'?'in WSL':'Windows');
    return `<button class="agent${on?'':' is-off'}" data-id="${esc(a.id)}" ${on?'':'aria-disabled="true"'} title="${on?'Apri '+esc(a.name)+' collegato a colibri':esc(a.name)+': '+sub}"><span class="agent__logo">${AGENT_ICONS[a.id]||''}</span><b>${esc(a.name)}</b><small>${esc(sub)}</small></button>`}).join('');
