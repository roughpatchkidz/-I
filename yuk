const I18N_SKIP='script,style,svg,.md,.thinking__body,.msg-user,.lv-steps,.wsteps,pre,code,textarea,[data-noi18n]';
const I18N_ATTRS=['title','placeholder','data-tip','aria-label'];
/* node -> {src: its Italian, out: what this script wrote}; an element -> {attr: {src, out}} */
const i18nText=new WeakMap(),i18nAttr=new WeakMap();
function trNode(n,again){const p=n.parentElement;if(!p||p.closest(I18N_SKIP))return;const v=n.nodeValue,r=i18nText.get(n);
  let src=v;if(r&&v===r.out){if(!again)return;src=r.src}   /* the page wrote anything else: that is the new source */
  const t=tr(src);i18nText.set(n,{src,out:t});if(t!==v)n.nodeValue=t}
function trEl(el,again){const sk=el.tagName==='TEXTAREA'?el.parentElement:el;if(sk&&sk.closest(I18N_SKIP))return;   /* a textarea: its placeholder and title, never what it holds */let m=i18nAttr.get(el);if(!m){m={};i18nAttr.set(el,m)}
  for(const a of I18N_ATTRS){const v=el.getAttribute(a);if(!v)continue;const r=m[a];let src=v;
    if(r&&v===r.out){if(!again)continue;src=r.src}
    const t=tr(src);m[a]={src,out:t};if(t!==v)el.setAttribute(a,t)}}
function trTree(r,again){const w=document.createTreeWalker(r,NodeFilter.SHOW_TEXT);let n;while((n=w.nextNode()))trNode(n,again);
  if(r.querySelectorAll)r.querySelectorAll('[title],[placeholder],[data-tip],[aria-label]').forEach(e=>trEl(e,again));if(r.nodeType===1)trEl(r,again)}
