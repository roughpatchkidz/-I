/* Markdown inside an assistant turn. The model writes fences, lists and links;
   rendered as React nodes, never as HTML, so nothing here can inject markup. */
.md>div>*:first-child{margin-top:0}
.md>div>*:last-child{margin-bottom:0}
.md p{margin:0 0 .75em}
.md h2,.md h3,.md h4,.md h5{margin:1.1em 0 .5em;line-height:1.25;font-weight:600}
.md h2{font-size:1.18em}.md h3{font-size:1.08em}.md h4{font-size:1em}.md h5{font-size:.95em;opacity:.85}
.md ul,.md ol{margin:0 0 .75em;padding-left:1.35em}
.md li{margin:.2em 0}
.md li::marker{color:var(--primary)}
.md a{color:var(--primary);text-underline-offset:2px}
.md blockquote{margin:0 0 .75em;padding:.1em 0 .1em .85em;border-left:2px solid var(--primary);opacity:.9}
.md hr{border:0;border-top:1px solid color-mix(in srgb,var(--foreground) 18%,transparent);margin:1.1em 0}
.md :not(pre)>code{background:color-mix(in srgb,var(--foreground) 10%,transparent);padding:.12em .36em;border-radius:.35em;font-size:.92em}
.md-table{margin:0 0 .85em;overflow-x:auto;border:1px solid color-mix(in srgb,var(--foreground) 14%,transparent);border-radius:.6em}
.md-table table{border-collapse:collapse;width:100%;font-size:.92em;font-variant-numeric:tabular-nums}
.md-table th,.md-table td{padding:.42em .7em;text-align:left;vertical-align:top;border-bottom:1px solid color-mix(in srgb,var(--foreground) 10%,transparent)}
.md-table thead th{font-weight:600;white-space:nowrap;background:color-mix(in srgb,var(--foreground) 5%,transparent);border-bottom:1px solid color-mix(in srgb,var(--foreground) 16%,transparent)}
.md-table tbody tr:last-child td{border-bottom:0}
.md-table :not(pre)>code{font-size:.9em}
.md-code{margin:0 0 .85em;border:1px solid color-mix(in srgb,var(--foreground) 14%,transparent);border-radius:.6em;overflow:hidden;background:color-mix(in srgb,var(--foreground) 5%,transparent)}
.md-code figcaption{display:flex;align-items:center;justify-content:space-between;gap:.5em;padding:.35em .5em .35em .75em;font-size:.78em;letter-spacing:.04em;text-transform:uppercase;opacity:.7;border-bottom:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}
.md-code figcaption button{display:inline-flex;align-items:center;justify-content:center;width:1.9em;height:1.9em;border-radius:.4em;color:inherit;opacity:.8}
.md-code figcaption button:hover{opacity:1;background:color-mix(in srgb,var(--foreground) 10%,transparent)}
.md-code figcaption svg{width:.95em;height:.95em}
.md-code pre{margin:0;padding:.75em .85em;overflow-x:auto}
.md-code code{font-size:.9em;line-height:1.55;white-space:pre}


/* Attached pictures: thumbnails while composing, full width once sent. */
.composer-attachments{display:flex;flex-wrap:wrap;gap:.5rem;padding:.6rem .75rem 0}
.attachment{position:relative;display:inline-flex}
.attachment img{width:64px;height:64px;object-fit:cover;border-radius:.5rem;border:1px solid color-mix(in srgb,var(--foreground) 16%,transparent)}
.attachment button{position:absolute;top:-6px;right:-6px;display:inline-flex;align-items:center;justify-content:center;width:1.25rem;height:1.25rem;border-radius:50%;background:var(--card);border:1px solid color-mix(in srgb,var(--foreground) 22%,transparent);color:inherit}
.attachment button svg{width:.7rem;height:.7rem}
.attach-chip{display:inline-flex;align-items:center;justify-content:center;width:2rem;height:2rem;border-radius:.6rem;color:inherit;opacity:.75}
.attach-chip:hover{opacity:1;background:color-mix(in srgb,var(--foreground) 10%,transparent)}
.attach-chip svg{width:1.05rem;height:1.05rem}
.message-images{display:flex;flex-wrap:wrap;gap:.5rem;margin:0 0 .5rem}
.message-images img{max-width:min(320px,100%);border-radius:.6rem;border:1px solid color-mix(in srgb,var(--foreground) 14%,transparent)}

/* ---- modalita brio -------------------------------------------------------
   Una colonna sola: il documento in alto, le opzioni comuni, poi le domande
   una sotto l'altra con la propria risposta sotto. La forma segue il motivo
   per cui la modalita esiste: il documento si legge una volta e le domande
   sono tante, quindi il documento sta in cima e le domande si accumulano. */
.brio-page{max-width:1080px;margin:0 auto;display:grid;gap:14px}
.brio-card{background:var(--card);border-radius:20px;padding:22px 24px}
.brio-card h2{font-size:14px;font-weight:500;margin:0}
.brio-card textarea,.brio-card input{width:100%;display:block;background:var(--input);border:1px solid transparent;border-radius:14px;padding:11px 14px;font:inherit;font-size:13px;line-height:1.6;color:var(--foreground);outline:none;resize:vertical}
.brio-card textarea::placeholder,.brio-card input::placeholder{color:var(--muted-foreground)}
.brio-card textarea:focus,.brio-card input:focus{border-color:color-mix(in srgb,var(--foreground) 25%,transparent)}

.brio-doc-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.brio-doc-head h2{margin-right:auto}
.brio-doc-head button{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);border-radius:20px;background:none;color:var(--muted-foreground);font-size:11px;padding:7px 13px}
.brio-doc-head button:hover{color:var(--foreground);border-color:color-mix(in srgb,var(--foreground) 30%,transparent)}
.brio-doc-head svg{width:14px;height:14px}
.brio-meta{margin:10px 0 0;font-size:11px;color:var(--muted-foreground)}
.brio-meta b{color:var(--foreground);font-weight:400}

.brio-shared h2{margin-bottom:12px}
.brio-chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:11px}
.brio-chips button{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:20px;background:none;color:var(--muted-foreground);font-size:11px;padding:5px 9px 5px 12px}
.brio-chips button:hover{color:var(--foreground);border-color:color-mix(in srgb,var(--foreground) 30%,transparent)}
.brio-chips svg{width:12px;height:12px}

.brio-questions{display:grid;gap:12px}
.brio-q-head{display:flex;align-items:center;gap:11px}
.brio-num{width:24px;height:24px;flex-shrink:0;display:grid;place-items:center;border-radius:50%;background:var(--secondary);color:var(--muted-foreground);font-size:11px;font-variant-numeric:tabular-nums}
.brio-q-head input{font-size:14px}
.brio-drop{width:30px;height:30px;flex-shrink:0;display:grid;place-items:center;border:0;border-radius:9px;background:none;color:var(--muted-foreground)}
.brio-drop:hover{background:var(--secondary);color:var(--foreground)}
.brio-drop svg{width:15px;height:15px}
.brio-own{margin-top:10px;font-size:12px!important;padding:9px 14px!important;line-height:1.7}
.brio-warn{margin:8px 0 0;font-size:11px;color:#e0b062}

.brio-running{display:flex;align-items:center;gap:9px;margin:16px 0 0;font-size:12px;color:var(--muted-foreground)}
.brio-running svg{width:15px;height:15px}
.brio-spin{animation:brio-turn 1s linear infinite}
@keyframes brio-turn{to{transform:rotate(360deg)}}

.brio-answer{margin-top:18px;padding-top:16px;border-top:1px solid var(--border)}
.brio-bars{display:grid;gap:2px}
.brio-bar{display:grid;grid-template-columns:minmax(0,11rem) minmax(0,1fr) 4.4rem;align-items:center;gap:14px;padding:6px 0}
.brio-name{font-size:13px;color:var(--muted-foreground);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.brio-bar.top .brio-name{color:var(--foreground)}
.brio-track{height:8px;border-radius:5px;background:var(--secondary);overflow:hidden}
.brio-fill{display:block;height:100%;border-radius:5px;background:color-mix(in srgb,var(--foreground) 22%,transparent);transition:width .35s ease}
.brio-bar.top .brio-fill{background:var(--primary)}
.brio-pct{text-align:right;font:400 15px ui-sans-serif,system-ui,sans-serif;letter-spacing:-.3px;font-variant-numeric:tabular-nums}
.brio-pct i{font-style:normal;font-size:10px;color:var(--muted-foreground);margin-left:1px}

.brio-foot{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;margin-top:14px}
.brio-foot strong{font:450 21px ui-sans-serif,system-ui,sans-serif;letter-spacing:-.5px}
.brio-foot[data-level=sure] strong{color:var(--primary)}
.brio-foot[data-level=unsure] strong{color:#e0b062}
.brio-foot[data-level=unknown] strong{color:var(--muted-foreground)}
.brio-foot span{font-size:11px;color:var(--muted-foreground)}
.brio-foot em{margin-left:auto;font-style:normal;font-size:11px;color:var(--muted-foreground)}
.brio-foot em b{color:var(--primary);font-weight:400}

.brio-actions{display:flex;gap:11px;align-items:center;margin-top:2px}
.brio-add{display:inline-flex;align-items:center;gap:8px;border:1px dashed var(--border);border-radius:26px;background:none;color:var(--muted-foreground);font-size:12px;padding:13px 18px}
.brio-add:hover{color:var(--foreground);border-color:color-mix(in srgb,var(--foreground) 30%,transparent)}
.brio-add svg{width:15px;height:15px}
.brio-run{flex:1;display:flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:26px;padding:14px;font-size:13px;background:var(--primary);color:var(--primary-foreground)}
.brio-run svg{width:16px;height:16px}
.brio-note,.brio-error{font-size:11px;line-height:1.6;margin:12px 0 0;color:var(--muted-foreground)}
.brio-error{color:var(--destructive,#ff766f)}

@media(max-width:760px){
  .brio-card{padding:17px;border-radius:17px}
  .brio-bar{grid-template-columns:minmax(0,7rem) minmax(0,1fr) 3.8rem;gap:10px}
  .brio-foot em{margin-left:0;flex-basis:100%}
  .brio-actions{flex-wrap:wrap}
  .brio-add,.brio-run{flex:1 1 100%;justify-content:center}
  .brio-card textarea,.brio-card input{font-size:16px}
}

/* ---- text-to-image -------------------------------------------------------
   An image model's turn is a picture in a frame the size of the request, with
   the stage and a thin bar under it while it runs, then the parameters and
   three actions. The composer trades the chat's chips for size, steps and
   seed chips of the same shape. */
.image-turn{display:grid;gap:10px;min-width:0;max-width:100%}
.image-frame{position:relative;width:100%;overflow:hidden;border-radius:16px;background:var(--input)}
.image-frame>img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover}
.image-frame.pending{border:1px solid color-mix(in srgb,var(--foreground) 8%,transparent)}
/* A preview is a few dozen pixels of an unfinished latent: blown up, pixelated
   and blurred it reads as "taking shape", not as a broken picture. The scale
   hides the soft edge the blur leaves at the border. */
.image-frame>img.image-preview{image-rendering:pixelated;filter:blur(7px) saturate(1.15);transform:scale(1.08);transition:opacity .3s}
.image-shimmer{position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,color-mix(in srgb,var(--foreground) 7%,transparent) 50%,transparent 70%);background-size:220% 100%;animation:image-shimmer 1.8s linear infinite}
@keyframes image-shimmer{from{background-position:130% 0}to{background-position:-130% 0}}
.image-status{display:flex;align-items:center;gap:10px;min-width:0;font-size:12px;color:var(--muted-foreground)}
.image-stage{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--foreground)}
.image-clock{font-variant-numeric:tabular-nums}
.image-cancel{display:inline-flex;align-items:center;gap:5px;flex-shrink:0;border:1px solid color-mix(in srgb,var(--foreground) 18%,transparent);border-radius:20px;background:none;color:var(--muted-foreground);font-size:11px;padding:5px 10px}
.image-cancel svg{width:13px;height:13px}
.image-cancel:hover{color:var(--foreground);background:var(--secondary)}
.image-bar{height:4px;border-radius:4px;background:var(--secondary);overflow:hidden}
.image-bar>span{display:block;height:100%;border-radius:4px;background:var(--primary);transition:width .45s ease}
.image-bar.waiting>span{width:28%!important;animation:image-wait 1.5s ease-in-out infinite}
@keyframes image-wait{from{transform:translateX(-110%)}to{transform:translateX(370%)}}
.image-meta{display:flex;flex-wrap:wrap;gap:3px 14px;margin:0;font-size:11px;color:var(--muted-foreground);font-variant-numeric:tabular-nums}
.image-meta>span[title]{text-decoration:underline dotted color-mix(in srgb,var(--foreground) 30%,transparent);text-underline-offset:3px;cursor:help}
.image-actions{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.image-actions>span{font-size:10px;color:var(--muted-foreground)}
.image-action{display:inline-flex;align-items:center;gap:6px;border:1px solid color-mix(in srgb,var(--foreground) 18%,transparent);border-radius:20px;background:none;color:var(--muted-foreground);font-size:11px;padding:6px 11px}
.image-action svg{width:14px;height:14px;flex-shrink:0}
.image-action:hover:not(:disabled){color:var(--foreground);background:var(--secondary)}
.image-action.primary{color:var(--foreground)}
.image-stopped{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;padding:11px 12px 11px 15px;border:1px dashed var(--border);border-radius:14px;font-size:12px;color:var(--muted-foreground)}
.image-stopped>span{color:var(--foreground)}
.image-stopped>button{margin-left:auto}
.composer.image-mode .composer-foot{align-items:flex-end}
.image-controls{display:flex;flex-wrap:wrap;align-items:center;gap:6px;flex:1;min-width:0}
.image-chip{position:relative;display:inline-flex;align-items:center;gap:6px;height:31px;min-width:0;border:1px solid color-mix(in srgb,var(--foreground) 18%,transparent);border-radius:20px;padding:0 10px;font-size:11px;color:var(--muted-foreground)}
.image-chip>svg{width:14px;height:14px;flex-shrink:0}
.image-chip:focus-within{border-color:color-mix(in srgb,var(--foreground) 40%,transparent);color:var(--foreground)}
.image-chip select,.image-chip input{min-width:0;padding:0;border:0;outline:none;background:none;color:var(--foreground);font:inherit;font-variant-numeric:tabular-nums}
.image-chip input::placeholder{color:var(--muted-foreground)}
.image-chip select{appearance:none;padding-right:15px;margin-right:-15px;cursor:pointer}
.image-chip option,.image-chip optgroup{background:var(--card);color:var(--foreground)}
.image-chip>.image-caret{width:12px;height:12px;pointer-events:none}
.image-steps{width:2.6ch;text-align:right}
.image-seed{width:10ch}
.image-custom{gap:4px}
.image-custom input{width:4.4ch;text-align:center}
.image-chip.invalid,.image-custom input.invalid{border-color:color-mix(in srgb,var(--destructive,#ff766f) 60%,transparent);color:var(--destructive,#ff766f)}
/* Where the browser can, each field is as wide as what it shows, so the size
   chip is not stretched to fit "Custom size" while it says 768x512. */
@supports (field-sizing:content){.image-chip select,.image-chip input{field-sizing:content;width:auto}.image-steps{min-width:1ch}.image-seed{min-width:4ch}.image-custom input{min-width:3ch}}
.image-clear{display:grid;place-items:center;width:18px;height:18px;margin-right:-5px;padding:0;border:0;border-radius:50%;background:none;color:var(--muted-foreground)}
.image-clear:hover{background:var(--secondary);color:var(--foreground)}
.image-clear svg{width:11px;height:11px}
@media(max-width:760px){
  /* 16px keeps a phone from zooming into the field it focuses */
