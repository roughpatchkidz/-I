  skate:t=>(async()=>{const x0=M.x;await moveTo(Math.max(0,x0-160),220,t,['skate'],1);await wait(200,t);await moveTo(x0,220,t,['skate'],1);M.face=-1})(),
  fly:t=>(async()=>{setAnim(['fly1','fly2'],14);await tween(300,k=>{M.lift=-14*k},t);await wait(1200,t);await tween(260,k=>{M.lift=-14*(1-k)},t)})(),
  look:t=>(async()=>{setAnim('sit');M.face=1;await wait(900,t);M.face=-1;await wait(300,t)})(),
  swing:t=>(async()=>{setAnim(['sit','sit2'],3);await wait(2400,t)})(),
  sit:t=>(async()=>{setAnim('sit');await wait(4000,t)})(),
  lean:t=>(async()=>{setAnim('lean');await wait(3000,t)})(),
  read:t=>(async()=>{setAnim('read');await wait(3000,t)})(),
  tap:t=>(async()=>{setAnim(['stand','tap'],4);await wait(1600,t)})(),
  walk:t=>(async()=>{await moveTo(M.x-80,60,t);await wait(400,t);await backHome(t)})(),
  hide:t=>(async()=>{M.clip=true;setAnim('stand');await tween(300,k=>{M.y=k*BOX},t);await wait(900,t);await tween(260,k=>{M.y=BOX-k*BOX*.45},t);await wait(800,t);await tween(220,k=>{M.y=BOX*.55*(1-k)},t);M.clip=false})(),
