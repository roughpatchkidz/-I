/* clicks, double clicks and drag (only when the user asks for it) */
let down=null,clickTimer=null;
el.addEventListener('pointerdown',e=>{e.preventDefault();const r=el.getBoundingClientRect();down={x:e.clientX,y:e.clientY,ox:e.clientX-r.left,oy:e.clientY-r.top};el.setPointerCapture(e.pointerId)});
el.addEventListener('pointermove',e=>{if(!down)return;
  if(!M.dragging&&Math.hypot(e.clientX-down.x,e.clientY-down.y)>6){M.dragging=true;begin('drag');el.classList.add('dragging');setAnim(['fly1','fly2'],14)}
  if(M.dragging){const w=cwrap.getBoundingClientRect();const bx=e.clientX-w.left-down.ox,by=e.clientY-w.top-down.oy+BOX-1;
    el.style.transform=`translate(${bx}px,${by}px)`;el.style.clipPath='none';if(e.movementX)M.face=e.movementX>0?1:-1;M._dx=bx;M._dy=by}});
el.addEventListener('pointerup',e=>{const wasDrag=M.dragging;const d=down;down=null;
  if(wasDrag){M.dragging=false;el.classList.remove('dragging');const sx=M._dx,sy=M._dy;
    run(async t=>{M.x=sx;M.y=sy;setAnim(['fly1','fly2'],14);const tx=home();M.face=tx>sx?1:-1;
      await tween(650,k=>{const e2=1-Math.pow(1-k,3);M.x=sx+(tx-sx)*e2;M.y=sy*(1-e2)},t);M.y=0;M.face=-1;setAnim('crouch');await wait(120,t)});return}
  if(!d)return;
  if(clickTimer){clearTimeout(clickTimer);clickTimer=null;act('dance');return}
  clickTimer=setTimeout(()=>{clickTimer=null;act(pick(['flap','jump','cheer','skate','fly','hide']))},230)});

