  const x=side*(.058+(.98+fold)*sa*cb),y=((sb<0?.78:.56)+fold)*sa*sb-.035*ca,z=(1.10+fold)*ca;
  cortexVertices.push({x,y,z,shade:.5+.28*Math.sin(9*a+2.1*Math.sin(3*b))+.13*Math.sin(9*b+3*Math.cos(5*a))});
 }
